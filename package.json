{
  "name": "hsr-green-energy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HSR Green Energy bilingual CNG cylinder hydro testing and booking platform",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "npm run build && npx wrangler deploy",
    "cf:dev": "npm run build && npx wrangler dev",
    "db:migrate:local": "npx wrangler d1 migrations apply hsr_green_energy_prod --local",
    "db:migrate:remote": "npx wrangler d1 migrations apply hsr_green_energy_prod --remote",
    "typecheck": "astro check",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "db:migrate:preview": "npx wrangler d1 migrations apply hsr_green_energy_preview --remote"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.7",
    "@astrojs/react": "^7.1.8",
    "astro": "^7.4.11",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261112.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitest/coverage-v8": "^4.0.8",
    "eslint": "^9.39.1",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.0.8",
    "wrangler": "^4.160.0"
  }
}
