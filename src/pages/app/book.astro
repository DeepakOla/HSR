---
import CustomerLayout from '../../layouts/CustomerLayout.astro';
import InlineBooking from '../../components/booking/InlineBooking';
---

<CustomerLayout title="Book Testing Appointment | HSR Technical Services" activeNav="overview" breadcrumb="Book test">
  <div style="margin-bottom: 1.5rem;">
    <h1 style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.8rem; font-weight: 800; color: #0a1128; margin: 0 0 0.25rem;">
      Reserve Testing Bay
    </h1>
    <p style="color: #64748b; font-size: 0.92rem; margin: 0;">
      Schedule your 300-bar hydrostatic stretch test at HSR Green Energy, Rewari.
    </p>
  </div>

  <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 2rem;">
    <InlineBooking client:load locale="en" />
  </div>
</CustomerLayout>
