---
import CustomerLayout from '../../layouts/CustomerLayout.astro';
import { getCustomerSessionFromCookie } from '../../lib/customer-auth';
import { getRuntimeEnv } from '../../lib/runtime-env';

const env = getRuntimeEnv(Astro.locals);
const session = await getCustomerSessionFromCookie(Astro.request, env);

let testHistory: any[] = [];
if (env?.DB && session) {
  try {
    const res = await env.DB.prepare(
      `SELECT b.id, b.booking_token as bookingToken,
              COALESCE(b.display_reg_no, v.display_reg_no, v.registration_display, 'HR-26-XX-0000') as displayRegNo,
              COALESCE(b.slot_date, b.service_date) as testDate,
              b.booking_status as bookingStatus,
              b.testing_status as testingStatus,
              ctr.test_outcome as testOutcome,
              ctr.peso_certificate_number as certNo,
              ctr.retest_due_date as retestDueDate
       FROM bookings b
       LEFT JOIN booking_groups bg ON bg.id = b.booking_group_id
       LEFT JOIN vehicles v ON v.id = b.vehicle_id
       LEFT JOIN cylinder_test_records ctr ON ctr.booking_id = b.id
       WHERE (bg.booker_party_id = ? OR b.rc_owner_party_id = ?)
       ORDER BY b.created_at DESC`
    )
      .bind(session.partyId, session.partyId)
      .all<any>();
    testHistory = res.results || [];
  } catch (e) {
    // Graceful fallback
  }
}
---

<CustomerLayout title="Test History | HSR Technical Services" activeNav="history" breadcrumb="Test history">
  <div style="margin-bottom: 1.5rem;">
    <h1 style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.8rem; font-weight: 800; color: #0a1128; margin: 0 0 0.25rem;">
      Hydro Testing History
    </h1>
    <p style="color: #64748b; font-size: 0.92rem; margin: 0;">
      Official PESO hydrostatic test records and inspection outcomes.
    </p>
  </div>

  {testHistory.length > 0 ? (
    <div style="background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden;">
      <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.88rem;">
        <thead style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #64748b; font-size: 0.78rem; text-transform: uppercase;">
          <tr>
            <th style="padding: 0.85rem 1.25rem;">Vehicle</th>
            <th style="padding: 0.85rem 1rem;">Test Date</th>
            <th style="padding: 0.85rem 1rem;">Outcome</th>
            <th style="padding: 0.85rem 1rem;">Valid Until</th>
            <th style="padding: 0.85rem 1rem;">Certificate</th>
          </tr>
        </thead>
        <tbody>
          {testHistory.map((item) => (
            <tr style="border-bottom: 1px solid #f1f5f9;">
              <td style="padding: 1rem 1.25rem; font-family: 'JetBrains Mono', monospace; font-weight: 700;">
                {item.displayRegNo}
              </td>
              <td style="padding: 1rem;">{item.testDate}</td>
              <td style="padding: 1rem;">
                <span style={`padding: 0.25rem 0.5rem; border-radius: 6px; font-weight: 700; font-size: 0.75rem; ${item.testOutcome === 'PASS' || item.bookingStatus === 'COMPLETED' ? 'background: #dcfce7; color: #15803d;' : 'background: #fef3c7; color: #b45309;'}`}>
                  {item.testOutcome || item.bookingStatus}
                </span>
              </td>
              <td style="padding: 1rem; color: #166534; font-weight: 600;">
                {item.retestDueDate || '—'}
              </td>
              <td style="padding: 1rem;">
                <a href={`/booking-status/${item.bookingToken}`} style="color: #0284c7; font-weight: 600; text-decoration: none;">
                  View Record →
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : (
    <div style="background: #ffffff; border: 1px dashed #cbd5e1; border-radius: 12px; padding: 3.5rem 2rem; text-align: center;">
      <div style="font-size: 2.5rem; margin-bottom: 1rem;">🕒</div>
      <div style="font-weight: 700; font-size: 1.1rem; color: #0a1128; margin-bottom: 0.35rem;">No past testing history</div>
      <div style="font-size: 0.88rem; color: #64748b; margin-bottom: 1.5rem;">
        Once your vehicle completes its 300-bar hydrostatic stretch test at our Rewari facility, statutory inspection slips and certificates will appear here.
      </div>
      <a href="/en/book" style="background: #166534; color: #fff; padding: 0.6rem 1.25rem; border-radius: 8px; font-weight: 700; font-size: 0.9rem; text-decoration: none;">
        Book Inspection Appointment
      </a>
    </div>
  )}
</CustomerLayout>
