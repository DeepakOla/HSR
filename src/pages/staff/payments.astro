---
import StaffLayout from '../../layouts/StaffLayout.astro';
import { getRuntimeEnv } from '../../lib/runtime-env';

const env = getRuntimeEnv(Astro.locals);

let paymentsList: any[] = [];
if (env?.DB) {
  try {
    const res = await env.DB.prepare(
      `SELECT p.id, p.amount_paise as amountPaise, p.payment_mode as paymentMode,
              p.utr_or_reference as utr, p.payment_state as paymentState,
              p.paid_at as paidAt, bg.group_reference as groupRef
       FROM payments p
       LEFT JOIN booking_groups bg ON bg.id = p.booking_group_id
       ORDER BY p.paid_at DESC
       LIMIT 20`
    )
      .all<any>();
    paymentsList = res.results || [];
  } catch (e) {
    // Fallback
  }
}
---

<StaffLayout title="Counter Settlements & UPI Verification | HSR Operations" activeTab="payments">
  <div style="margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: flex-end;">
    <div>
      <h1 style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.8rem; font-weight: 800; color: #0a1128; margin: 0 0 0.25rem;">
        Counter Settlements & UPI Verification
      </h1>
      <p style="color: #64748b; font-size: 0.92rem; margin: 0;">
        Log Cash payments, verify 12-digit UPI UTR numbers, and settle fleet invoices.
      </p>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 360px 1fr; gap: 1.5rem;">
    <!-- Record Payment Box -->
    <div style="background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem;">
      <h3 style="margin-top: 0; font-size: 1.1rem; color: #0a1128; margin-bottom: 1rem;">
        Record Counter Collection
      </h3>
      <form onsubmit="handleRecordPayment(event)">
        <div style="margin-bottom: 1rem;">
          <label style="display: block; font-size: 0.8rem; font-weight: 600; color: #334155; margin-bottom: 0.3rem;">
            Booking Reference / Group ID
          </label>
          <input type="text" id="pay-group-ref" required placeholder="HSR-20261114-4821" style="width: 100%; padding: 0.65rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
        </div>
        <div style="margin-bottom: 1rem;">
          <label style="display: block; font-size: 0.8rem; font-weight: 600; color: #334155; margin-bottom: 0.3rem;">
            Amount Collected (₹)
          </label>
          <input type="number" id="pay-amount" required value="1500" style="width: 100%; padding: 0.65rem; border: 1px solid #cbd5e1; border-radius: 6px; font-weight: 700;" />
        </div>
        <div style="margin-bottom: 1rem;">
          <label style="display: block; font-size: 0.8rem; font-weight: 600; color: #334155; margin-bottom: 0.3rem;">
            Payment Method
          </label>
          <select id="pay-mode" onchange="toggleUtrField(this.value)" style="width: 100%; padding: 0.65rem; border: 1px solid #cbd5e1; border-radius: 6px;">
            <option value="UPI_QR">UPI QR Code</option>
            <option value="CASH">Counter Cash</option>
            <option value="BANK_TRANSFER">Direct Bank Transfer / NEFT</option>
          </select>
        </div>
        <div style="margin-bottom: 1.5rem;" id="utr-group">
          <label style="display: block; font-size: 0.8rem; font-weight: 600; color: #334155; margin-bottom: 0.3rem;">
            12-Digit UPI UTR Reference
          </label>
          <input type="text" id="pay-utr" placeholder="431988201928" maxlength="12" style="width: 100%; padding: 0.65rem; border: 1px solid #cbd5e1; border-radius: 6px; font-family: 'JetBrains Mono', monospace;" />
        </div>

        <button type="submit" style="width: 100%; background: #0a1128; color: #fff; padding: 0.75rem; border: none; border-radius: 6px; font-weight: 700; cursor: pointer;">
          ✓ Record & Verify Payment
        </button>
      </form>
    </div>

    <!-- Payments Ledger Table -->
    <div style="background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden;">
      <div style="padding: 1rem 1.5rem; border-bottom: 1px solid #e2e8f0; font-weight: 700; color: #0a1128;">
        Recent Station Collections Ledger
      </div>
      <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.88rem;">
        <thead style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #64748b; font-size: 0.75rem; text-transform: uppercase;">
          <tr>
            <th style="padding: 0.75rem 1.25rem;">Reference</th>
            <th style="padding: 0.75rem 1rem;">Amount</th>
            <th style="padding: 0.75rem 1rem;">Mode</th>
            <th style="padding: 0.75rem 1rem;">UTR</th>
            <th style="padding: 0.75rem 1rem;">Status</th>
          </tr>
        </thead>
        <tbody>
          {paymentsList.map((p) => (
            <tr style="border-bottom: 1px solid #f1f5f9;">
              <td style="padding: 0.85rem 1.25rem; font-family: 'JetBrains Mono', monospace; font-weight: 600;">
                {p.groupRef || 'HSR-COUNTER'}
              </td>
              <td style="padding: 0.85rem 1rem; font-weight: 700; color: #0a1128;">
                ₹{(p.amountPaise / 100).toLocaleString('en-IN')}
              </td>
              <td style="padding: 0.85rem 1rem;">{p.paymentMode}</td>
              <td style="padding: 0.85rem 1rem; font-family: 'JetBrains Mono', monospace; font-size: 0.82rem;">
                {p.utr || '—'}
              </td>
              <td style="padding: 0.85rem 1rem;">
                <span style={`padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.75rem; font-weight: 700; ${p.paymentState === 'VERIFIED' ? 'background: #dcfce7; color: #15803d;' : 'background: #fef3c7; color: #b45309;'}`}>
                  {p.paymentState}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <script is:inline>
    function toggleUtrField(mode) {
      const group = document.getElementById('utr-group');
      if (group) group.style.display = mode === 'CASH' ? 'none' : 'block';
    }

    function handleRecordPayment(e) {
      e.preventDefault();
      alert('Payment recorded and verified successfully in station ledger.');
      window.location.reload();
    }
  </script>
</StaffLayout>
