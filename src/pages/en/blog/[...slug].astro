---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { calculateReadingTime } from '../../../lib/reading-time';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft && data.locale === 'en');
  return posts.map((post) => {
    const slug = post.id.replace(/^en\//, '').replace(/\.(md|mdx)$/, '');
    return {
      params: { slug },
      props: { post, slug },
    };
  });
}

const { post, slug } = Astro.props;
const { Content } = await render(post);
const readingTime = calculateReadingTime(post.body || '', 'en');
const formattedDate = post.data.pubDate.toLocaleDateString('en-IN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  locale="en"
  title={`${post.data.title} | HSR`}
  description={post.data.description}
  canonicalPath={`/en/blog/${slug}/`}
  businessName="HSR"
>
  <article class="section">
    <div class="container" style="max-width: 820px;">
      <!-- Schema.org BlogPosting JSON-LD -->
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "headline": post.data.title,
        "description": post.data.description,
        "datePublished": post.data.pubDate.toISOString(),
        "author": {
          "@type": "Person",
          "name": post.data.author
        },
        "publisher": {
          "@type": "Organization",
          "name": "HSR Green Energy",
          "url": "https://hsrgreenenergy.com"
        },
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": `https://hsrgreenenergy.com/en/blog/${slug}/`
        }
      })} />

      <div style="margin-bottom: 2rem;">
        <a href="/en/blog/" style="display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.9rem; color: var(--color-steel-600); margin-bottom: 1rem; text-decoration: none; font-weight: 600;">
          ← Back to All Articles
        </a>
        <h1 style="font-size: clamp(1.8rem, 4vw, 2.75rem); line-height: 1.25; margin-bottom: 1rem;">
          {post.data.title}
        </h1>
        <div style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; color: var(--color-slate-600); font-size: 0.95rem; border-bottom: 1px solid var(--border-default); padding-bottom: 1rem;">
          <time datetime={post.data.pubDate.toISOString()}>Published: {formattedDate}</time>
          <span>•</span>
          <span>{readingTime}</span>
          <span>•</span>
          <span>By {post.data.author}</span>
        </div>
      </div>

      <div class="blog-prose card" style="padding: 2.5rem 2rem;">
        <Content />
      </div>

      <!-- Social Share & Tags Row -->
      <div style="margin-top: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; padding: 1rem 0; border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle);">
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
          <span style="font-weight: 700; font-size: 0.9rem;">Tags:</span>
          {post.data.tags.map((tag) => (
            <span class="trust-badge" style="background: var(--color-slate-100); border-color: var(--border-default);">
              #{tag}
            </span>
          ))}
        </div>

        <div style="display: flex; gap: 0.5rem; align-items: center;">
          <span style="font-weight: 600; font-size: 0.85rem; color: var(--color-slate-600);">Share:</span>
          <a
            href={`https://api.whatsapp.com/send?text=${encodeURIComponent(`${post.data.title} - https://hsrgreenenergy.com/en/blog/${slug}/`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline"
            style="padding: 0.35rem 0.75rem; font-size: 0.82rem; min-height: 36px; background: #25D366; color: #ffffff; border-color: #25D366;"
          >
            WhatsApp
          </a>
          <a
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(`https://hsrgreenenergy.com/en/blog/${slug}/`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline"
            style="padding: 0.35rem 0.75rem; font-size: 0.82rem; min-height: 36px; background: #0f172a; color: #ffffff; border-color: #0f172a;"
          >
            X (Twitter)
          </a>
        </div>
      </div>

      <!-- Author Credential Card -->
      <div class="card" style="margin-top: 2rem; display: flex; gap: 1.25rem; align-items: center; padding: 1.5rem; background: var(--color-slate-50);">
        <div style="width: 54px; height: 54px; border-radius: 50%; background: var(--color-navy-900); color: #ffffff; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; flex-shrink: 0;">
          👨‍🔧
        </div>
        <div>
          <strong style="color: var(--color-navy-900); display: block; font-size: 1.05rem;">{post.data.author}</strong>
          <span style="font-size: 0.85rem; color: var(--color-slate-600); display: block; margin-top: 0.15rem;">
            Certified Hydrostatic Testing Technical Team • HSR Green Energy, Rewari
          </span>
          <p style="font-size: 0.85rem; color: var(--color-slate-500); margin: 0.4rem 0 0;">
            Specialists in Gas Cylinders Rules 2016, 300 Bar water jacket testing, and MoRTH compliance standards.
          </p>
        </div>
      </div>

      <div class="card" style="margin-top: 3rem; background: var(--color-steel-50); border-color: var(--color-steel-100); text-align: center; padding: 2rem;">
        <h3 style="margin-top: 0; color: var(--color-navy-900);">Due for CNG Cylinder Hydro Testing?</h3>
        <p style="color: var(--color-slate-600); margin-bottom: 1.5rem;">
          Book your slot online to ensure safety compliance and prevent refueling refusal.
        </p>
        <a href="/en/book/" class="btn btn-primary">
          Book Testing Appointment
        </a>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .blog-prose {
    line-height: 1.8;
    font-size: 1.05rem;
  }
  .blog-prose :global(h2) {
    font-size: 1.5rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: var(--color-navy-900);
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 0.35rem;
  }
  .blog-prose :global(h3) {
    font-size: 1.25rem;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    color: var(--color-navy-800);
  }
  .blog-prose :global(p) {
    margin-bottom: 1.25rem;
  }
  .blog-prose :global(ul), .blog-prose :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }
  .blog-prose :global(li) {
    margin-bottom: 0.5rem;
  }
</style>
