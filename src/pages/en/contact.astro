---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentPage from '../../components/ContentPage.astro';
import { getDb, getBusinessSettings } from '../../lib/db';
import { getPageContent, getSeoMeta } from '../../lib/content';

const db = getDb(Astro);
const [settings, seo, page] = await Promise.all([
  getBusinessSettings(db),
  getSeoMeta(db, 'en'),
  getPageContent(db, 'en', 'contact'),
]);
---

<BaseLayout locale="en" title={page.title} description={seo.description} canonicalPath="/en/contact/" businessName={settings.business_name_en}>
  <ContentPage title={page.title} body={page.body} />
</BaseLayout>
