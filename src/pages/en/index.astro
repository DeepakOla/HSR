---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomePage from '../../components/HomePage.astro';
import { getDb, getBusinessSettings } from '../../lib/db';
import { getSeoMeta } from '../../lib/content';

const db = getDb(Astro);
const [settings, seo] = await Promise.all([getBusinessSettings(db), getSeoMeta(db, 'en')]);
---

<BaseLayout locale="en" title={seo.title} description={seo.description} canonicalPath="/en/" businessName={settings.business_name_en} settings={settings}>
  <HomePage locale="en" settings={settings} />
</BaseLayout>
