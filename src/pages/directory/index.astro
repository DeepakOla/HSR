---
// File: src/pages/directory/index.astro
import '../../styles/design-tokens.css';

const pageTitle = "Verified PESO Form GCT CNG Cylinder Testing Directory (Gurugram, Rewari, Manesar, Dharuhera)";
const pageDescription = "Official 2026 PESO Form GCT station finder for Haryana NCR. Compare road distance, live license validity, counter pricing, and avoid unlicensed middleman feeder garages.";
const canonicalUrl = "https://hsrgreenenergy.in/directory/";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content="website" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />

  <style>
    :root {
      --font-heading: 'Plus Jakarta Sans', system-ui, sans-serif;
      --font-body: 'Inter', system-ui, sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
      --primary: #ea580c;
      --primary-dark: #c2410c;
      --navy: #0a1128;
      --slate-bg: #f8fafc;
      --card-bg: #ffffff;
      --border-color: #e2e8f0;
    }
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      font-family: var(--font-body);
      background-color: var(--slate-bg);
      color: #0f172a;
      line-height: 1.5;
    }
    .top-alert {
      background: #0f172a;
      color: #ffffff;
      font-size: 0.8rem;
      padding: 0.65rem 1rem;
      text-align: center;
      line-height: 1.4;
    }
    .top-alert strong {
      color: #f59e0b;
    }
    .nav-bar {
      background: #ffffff;
      border-bottom: 1px solid var(--border-color);
      padding: 0.85rem 1.25rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 30;
    }
    .nav-brand {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      text-decoration: none;
      color: var(--navy);
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 1.15rem;
    }
    .nav-brand-tag {
      background: #fed7aa;
      color: #9a3412;
      font-size: 0.65rem;
      font-weight: 800;
      padding: 0.15rem 0.5rem;
      border-radius: 9999px;
      text-transform: uppercase;
    }
    .nav-links {
      display: flex;
      gap: 1rem;
      align-items: center;
    }
    .nav-link {
      font-size: 0.85rem;
      font-weight: 600;
      color: #475569;
      text-decoration: none;
      transition: color 0.15s ease;
    }
    .nav-link:hover {
      color: var(--primary);
    }
    .nav-btn {
      background: var(--navy);
      color: #ffffff;
      font-size: 0.82rem;
      font-weight: 700;
      padding: 0.45rem 0.9rem;
      border-radius: 8px;
      text-decoration: none;
      transition: background 0.15s ease;
    }
    .nav-btn:hover {
      background: #1e293b;
    }
    .container {
      max-width: 1100px;
      margin: 2rem auto;
      padding: 0 1rem;
    }
    .search-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      padding: 1.75rem;
      box-shadow: 0 4px 6px -1px rgba(0,0,0,0.04);
      margin-bottom: 2rem;
    }
    .badge-corridor {
      display: inline-block;
      background: #e0f2fe;
      color: #0369a1;
      font-size: 0.72rem;
      font-weight: 800;
      padding: 0.25rem 0.75rem;
      border-radius: 9999px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-bottom: 0.5rem;
    }
    .search-title {
      font-family: var(--font-heading);
      font-size: clamp(1.5rem, 3vw, 2rem);
      font-weight: 800;
      color: var(--navy);
      letter-spacing: -0.02em;
      line-height: 1.2;
    }
    .search-subtitle {
      color: #64748b;
      font-size: 0.92rem;
      margin-top: 0.35rem;
      margin-bottom: 1.5rem;
    }
    .search-controls {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1rem;
      align-items: flex-end;
    }
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }
    .form-label {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      color: #475569;
      letter-spacing: 0.03em;
    }
    .form-select {
      background: #ffffff;
      border: 1px solid #cbd5e1;
      border-radius: 10px;
      padding: 0.65rem 0.85rem;
      font-size: 0.9rem;
      font-weight: 500;
      color: #0f172a;
      outline: none;
      transition: border-color 0.15s ease;
    }
    .form-select:focus {
      border-color: var(--primary);
    }
    .btn-gps {
      background: var(--primary);
      color: #ffffff;
      border: none;
      border-radius: 10px;
      padding: 0.7rem 1.25rem;
      font-size: 0.88rem;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      box-shadow: 0 2px 4px rgba(234, 88, 12, 0.2);
      transition: background 0.15s ease;
    }
    .btn-gps:hover {
      background: var(--primary-dark);
    }
    .results-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.25rem;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .results-title {
      font-size: 1.15rem;
      font-weight: 800;
      color: var(--navy);
      font-family: var(--font-heading);
    }
    .results-note {
      font-size: 0.78rem;
      color: #64748b;
      font-weight: 600;
    }
    .stations-list {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      margin-bottom: 2.5rem;
    }
    .station-card {
      background: #ffffff;
      border-radius: 16px;
      padding: 1.5rem;
      box-shadow: 0 2px 5px rgba(0,0,0,0.03);
      border: 1px solid var(--border-color);
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .station-card.flagship {
      border: 2px solid var(--primary);
      background: linear-gradient(135deg, #ffffff 0%, #fff7ed 100%);
      box-shadow: 0 6px 12px -2px rgba(234, 88, 12, 0.12);
    }
    .station-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .station-info {
      flex: 1;
      min-width: 280px;
    }
    .station-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      align-items: center;
      margin-bottom: 0.4rem;
    }
    .badge-flagship {
      background: var(--primary);
      color: #ffffff;
      font-size: 0.7rem;
      font-weight: 800;
      padding: 0.2rem 0.65rem;
      border-radius: 9999px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .badge-verified {
      background: #dcfce7;
      color: #166534;
      font-size: 0.7rem;
      font-weight: 700;
      padding: 0.2rem 0.65rem;
      border-radius: 9999px;
    }
    .badge-warning {
      background: #fef3c7;
      color: #92400e;
      font-size: 0.7rem;
      font-weight: 700;
      padding: 0.2rem 0.65rem;
      border-radius: 9999px;
    }
    .peso-tag {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 700;
      color: #64748b;
    }
    .station-name {
      font-family: var(--font-heading);
      font-size: 1.25rem;
      font-weight: 800;
      color: var(--navy);
      margin-bottom: 0.25rem;
    }
    .station-address {
      font-size: 0.82rem;
      color: #475569;
    }
    .distance-chip {
      background: var(--navy);
      color: #ffffff;
      padding: 0.65rem 1rem;
      border-radius: 12px;
      text-align: right;
      min-width: 140px;
    }
    .distance-val {
      font-size: 1.15rem;
      font-weight: 800;
      color: #38bdf8;
      display: block;
      line-height: 1.1;
    }
    .drive-time {
      font-size: 0.72rem;
      color: #cbd5e1;
      display: block;
      margin-top: 0.2rem;
    }
    .station-metrics-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 0.75rem;
      margin-top: 1.25rem;
      padding-top: 1rem;
      border-top: 1px solid #e2e8f0;
    }
    .metric-box {
      background: rgba(248, 250, 252, 0.8);
      border-radius: 10px;
      padding: 0.75rem;
    }
    .metric-label {
      font-size: 0.72rem;
      font-weight: 700;
      color: #64748b;
      display: block;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    .metric-price {
      font-size: 1.2rem;
      font-weight: 800;
      color: #0f172a;
      display: block;
      margin: 0.15rem 0;
    }
    .metric-price.hsr-green {
      color: #15803d;
    }
    .metric-price.high-rate {
      color: #dc2626;
    }
    .metric-note {
      font-size: 0.72rem;
      color: #64748b;
      line-height: 1.3;
      display: block;
    }
    .audit-note-box {
      margin-top: 0.85rem;
      background: #fffbeb;
      border: 1px solid #fde68a;
      border-radius: 8px;
      padding: 0.65rem 0.85rem;
      font-size: 0.75rem;
      color: #92400e;
      line-height: 1.4;
    }
    .eeco-alert-box {
      margin-top: 0.75rem;
      background: #fee2e2;
      border: 1px solid #fca5a5;
      border-radius: 8px;
      padding: 0.5rem 0.75rem;
      font-size: 0.75rem;
      font-weight: 700;
      color: #991b1b;
    }
    .action-row {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
      margin-top: 1rem;
    }
    .btn-action-primary {
      background: var(--primary);
      color: #ffffff;
      padding: 0.55rem 1rem;
      border-radius: 10px;
      font-size: 0.8rem;
      font-weight: 700;
      text-decoration: none;
      transition: background 0.15s ease;
    }
    .btn-action-primary:hover {
      background: var(--primary-dark);
    }
    .btn-action-secondary {
      background: var(--navy);
      color: #ffffff;
      padding: 0.55rem 1rem;
      border-radius: 10px;
      font-size: 0.8rem;
      font-weight: 700;
      text-decoration: none;
      transition: background 0.15s ease;
    }
    .btn-action-secondary:hover {
      background: #1e293b;
    }
    .btn-action-outline {
      background: #ffffff;
      border: 1px solid #cbd5e1;
      color: #334155;
      padding: 0.55rem 1rem;
      border-radius: 10px;
      font-size: 0.8rem;
      font-weight: 600;
      text-decoration: none;
    }
    .btn-action-outline:hover {
      background: #f1f5f9;
    }
    .feeder-alert-card {
      background: #fef2f2;
      border: 1px solid #fecaca;
      border-radius: 16px;
      padding: 1.5rem;
      margin-top: 2rem;
    }
    .feeder-tag {
      background: #dc2626;
      color: #ffffff;
      font-size: 0.68rem;
      font-weight: 800;
      padding: 0.2rem 0.6rem;
      border-radius: 9999px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .feeder-title {
      font-family: var(--font-heading);
      font-size: 1.15rem;
      font-weight: 800;
      color: #7f1d1d;
      margin-top: 0.4rem;
      margin-bottom: 0.35rem;
    }
    .feeder-desc {
      font-size: 0.8rem;
      color: #991b1b;
      line-height: 1.5;
      margin-bottom: 1.25rem;
    }
    .feeder-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1rem;
    }
    .feeder-item {
      background: #ffffff;
      border: 1px solid #fca5a5;
      border-radius: 12px;
      padding: 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }
    .feeder-item-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .feeder-name {
      font-size: 0.9rem;
      font-weight: 800;
      color: #7f1d1d;
    }
    .feeder-pill {
      background: #fee2e2;
      color: #991b1b;
      font-size: 0.65rem;
      font-weight: 800;
      padding: 0.15rem 0.45rem;
      border-radius: 4px;
    }
    .feeder-loc {
      font-size: 0.75rem;
      color: #64748b;
      font-weight: 600;
    }
    .feeder-risk {
      font-size: 0.75rem;
      color: #475569;
      line-height: 1.4;
    }
    .site-footer {
      border-top: 1px solid var(--border-color);
      padding: 2.5rem 1rem;
      text-align: center;
      font-size: 0.8rem;
      color: #64748b;
      margin-top: 3rem;
      background: #ffffff;
    }
    .site-footer a {
      color: var(--primary);
      text-decoration: none;
      font-weight: 600;
      margin: 0 0.5rem;
    }
  </style>
</head>
<body>
  <div class="top-alert">
    <strong>⚠️ NOV 2026 PESO REGULATORY ADVISORY:</strong> Multiple Haryana Form GCT licenses reached their 30/09/2026 renewal milestone & unlicensed middlemen are restricted on <code>online.peso.gov.in</code>. Verify direct plant credentials and transparent counter prices below.
  </div>

  <nav class="nav-bar">
    <a href="/en/" class="nav-brand">
      <span>⚡ HSR Green Energy</span>
      <span class="nav-brand-tag">Rewari Plant</span>
    </a>
    <div class="nav-links">
      <a href="/en/" class="nav-link">Home</a>
      <a href="/cng/cylinder-test/" class="nav-link">Hydro Testing</a>
      <a href="/tools/cng-expiry-checker/" class="nav-link">Due Date Checker</a>
      <a href="/website-guide/" class="nav-link">System Guide</a>
      <a href="/login/" class="nav-btn">Portal Sign-In →</a>
    </div>
  </nav>

  <main class="container">
    <section class="search-card">
      <span class="badge-corridor">Verified PESO Form GCT Directory • Gurugram–Rewari–NCR Corridor</span>
      <h1 class="search-title">Find Nearest PESO-Approved CNG Cylinder Testing Plant</h1>
      <p class="search-subtitle">
        Compare actual road distance, PESO Form GCT statutory license validity, verified November 2026 counter rates, and vehicle compatibility (Maruti Eeco / Heavy cascade).
      </p>

      <div class="search-controls">
        <div class="form-group">
          <label class="form-label" for="hubSelect">1. Select Highway Hub / Town</label>
          <select id="hubSelect" class="form-select">
            <option value="gurugram-rewari">Pataudi / Rewari–Pataudi Highway (Central Corridor)</option>
            <option value="gurugram">Gurugram City (Rajiv Chowk / Sohna Rd / Sheetla Mata)</option>
            <option value="manesar">IMT Manesar / Bilaspur Chowk (NH-48)</option>
            <option value="dharuhera">Dharuhera / Bhiwadi Bypass (NH-48)</option>
            <option value="rewari">Rewari City / Mahendergarh Rd / Sec-1</option>
            <option value="bahadurgarh">Bahadurgarh / Jhajjar</option>
            <option value="faridabad">Faridabad / Ballabhgarh</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="vehicleSelect">2. Filter by Vehicle Category</label>
          <select id="vehicleSelect" class="form-select">
            <option value="ALL">All Vehicles (Car / Taxi / Auto / Truck)</option>
            <option value="CAR">Passenger Car / Taxi (Single Cylinder)</option>
            <option value="EECO">Maruti Suzuki Eeco (Underbody Cylinder)</option>
            <option value="TRUCK_BUS">Heavy Bus / Multi-Axle Truck / Cascade</option>
          </select>
        </div>

        <div class="form-group">
          <button id="gpsBtn" type="button" class="btn-gps">
            📍 Use My Live GPS
          </button>
        </div>
      </div>
    </section>

    <section>
      <div class="results-header">
        <h2 id="resultsHeading" class="results-title">Loading verified PESO stations...</h2>
        <span class="results-note">Ranked: #1 HSR Flagship (Zero Middleman) + Shortest Road Distance</span>
      </div>
      <div id="stationsList" class="stations-list"></div>
    </section>

    <section class="feeder-alert-card">
      <span class="feeder-tag">Consumer Fraud & Feeder Garage Alert</span>
      <h3 class="feeder-title">Beware of Unlicensed "Feeder Garages" Masquerading as Hydro-Testing Plants</h3>
      <p class="feeder-desc">
        The workshops listed below appear in local searches for "CNG Cylinder Testing" across Gurugram, Dharuhera, and Rewari, but hold <strong>NO Form GCT license</strong> in the official PESO Haryana registry. They remove your cylinder and courier it to third-party plants for a ₹300–₹800 markup—or risk "eyewash" repainting without a 300-Bar water-jacket stretch test.
      </p>
      <div id="feederWarningsList" class="feeder-grid"></div>
    </section>
  </main>

  <footer class="site-footer">
    <p>© 2026 HSR Green Energy. PESO Certified CNG Cylinder Hydro Testing Laboratory, Rewari, Haryana.</p>
    <p style="margin-top: 0.5rem;">
      <a href="/en/">Home</a> •
      <a href="/cng/cylinder-test/">CNG Testing</a> •
      <a href="/directory/">Directory</a> •
      <a href="/tools/cng-expiry-checker/">Due Date Checker</a> •
      <a href="/website-guide/">Architecture Guide</a> •
      <a href="/login/">Staff & Owner Portal</a>
    </p>
  </footer>

  <script>
    const hubSelect = document.getElementById('hubSelect') as unknown as HTMLSelectElement;
    const vehicleSelect = document.getElementById('vehicleSelect') as unknown as HTMLSelectElement;
    const gpsBtn = document.getElementById('gpsBtn') as unknown as HTMLButtonElement;
    const stationsList = document.getElementById('stationsList')!;
    const feederWarningsList = document.getElementById('feederWarningsList')!;
    const resultsHeading = document.getElementById('resultsHeading')!;

    let currentCoords: { lat?: number; lng?: number } = {};

    async function loadDirectory() {
      const params = new URLSearchParams({
        hub: hubSelect.value,
        vehicle: vehicleSelect.value,
      });
      if (currentCoords.lat && currentCoords.lng) {
        params.set('lat', String(currentCoords.lat));
        params.set('lng', String(currentCoords.lng));
      }

      try {
        const res = await fetch(`/api/public/search-cng?${params.toString()}`);
        const data: any = await res.json();

        resultsHeading.textContent = `Showing ${data.stations.length} PESO Stations near ${data.origin.label}`;

        stationsList.innerHTML = data.stations
          .map((st: any) => {
            const isHsr = Number(st.is_hsr_flagship) === 1;
            const cardClass = isHsr ? 'station-card flagship' : 'station-card';

            const badgeHtml = isHsr
              ? `<span class="badge-flagship">#1 RECOMMENDED • ₹200 PRIORITY VOUCHER</span>`
              : st.license_verification_badge === 'PESO_VERIFIED_ACTIVE_2028'
              ? `<span class="badge-verified">PESO Verified (Valid to 30/09/2028)</span>`
              : st.license_verification_badge === 'PESO_RENEWAL_CHECK_SEP2026'
              ? `<span class="badge-warning">⚠️ License Hit 30/09/2026 Expiry — Verify Renewal</span>`
              : `<span class="badge-verified">${st.license_verification_badge.replace(/_/g, ' ')}</span>`;

            const eecoWarning =
              Number(st.accepts_maruti_eeco) === 0
                ? `<div class="eeco-alert-box">⛔ Online Portal Rejects Maruti Suzuki Eeco Underbody Cylinders</div>`
                : '';

            const ctaHtml = isHsr
              ? `<div class="action-row">
                   <a href="/tools/cng-expiry-checker" class="btn-action-primary">Claim ₹200 Priority Voucher (Pay ₹1,200)</a>
                   <a href="/en/#booking-form" class="btn-action-secondary">Reserve Priority Testing Bay →</a>
                 </div>`
              : `<div class="action-row">
                   <a href="/tools/cng-expiry-checker" class="btn-action-outline">Set Free 3-Year Due Date Alert on HSR</a>
                 </div>`;

            return `
              <div class="${cardClass}">
                <div class="station-head">
                  <div class="station-info">
                    <div class="station-badges">
                      ${badgeHtml}
                      <span class="peso-tag">PESO: ${st.peso_approval_no || 'Pending'} (${st.peso_doc_no || 'N/A'})</span>
                    </div>
                    <h3 class="station-name">${st.station_name}</h3>
                    <p class="station-address">${st.address_line} (${st.pincode}) • <strong>${st.landmark || ''}</strong></p>
                  </div>
                  <div class="distance-chip">
                    <span class="distance-val">${st.roadDistanceKm} km away</span>
                    <span class="drive-time">~${st.estimatedDriveMins} mins drive</span>
                  </div>
                </div>

                <div class="station-metrics-grid">
                  <div class="metric-box">
                    <span class="metric-label">Nov 2026 Car Price (1 Cyl)</span>
                    <span class="metric-price ${isHsr ? 'hsr-green' : st.car_price_inr >= 2500 ? 'high-rate' : ''}">
                      ${st.car_price_inr ? '₹' + st.car_price_inr.toLocaleString('en-IN') : 'Call to Confirm'}
                    </span>
                    <span class="metric-note">${st.price_transparency_note}</span>
                  </div>
                  <div class="metric-box">
                    <span class="metric-label">Turnaround & Bay Fit</span>
                    <span class="metric-price" style="font-size: 1rem;">~${st.median_turnaround_mins} mins</span>
                    <span class="metric-note">
                      Eeco Van: <strong>${st.accepts_maruti_eeco ? 'Yes' : 'BANNED Online'}</strong> | Heavy Truck: <strong>${st.supports_heavy_trucks ? 'Yes' : 'No'}</strong>
                    </span>
                  </div>
                  <div class="metric-box">
                    <span class="metric-label">Booking & Refund Terms</span>
                    <span class="metric-note" style="font-weight: 700; color: #0f172a; margin-bottom: 0.2rem;">${st.booking_mode_summary}</span>
                    <span class="metric-note">${st.refund_policy_summary}</span>
                  </div>
                </div>

                <div class="audit-note-box">
                  <strong>Audited Status:</strong> ${st.deduplication_and_audit_note}
                </div>
                ${eecoWarning}
                ${ctaHtml}
              </div>
            `;
          })
          .join('');

        feederWarningsList.innerHTML = data.feederWarnings
          .map(
            (w: any) => `
            <div class="feeder-item">
              <div class="feeder-item-head">
                <span class="feeder-name">${w.business_name}</span>
                <span class="feeder-pill">NO PESO LICENSE</span>
              </div>
              <span class="feeder-loc">📍 ${w.claimed_location}</span>
              <p class="feeder-risk">${w.consumer_risk_explanation}</p>
            </div>
          `
          )
          .join('');
      } catch (e) {
        resultsHeading.textContent = 'Failed to load directory. Please refresh.';
      }
    }

    hubSelect.addEventListener('change', () => {
      currentCoords = {};
      loadDirectory();
    });
    vehicleSelect.addEventListener('change', loadDirectory);

    gpsBtn.addEventListener('click', () => {
      if (!navigator.geolocation) {
        alert('Geolocation is not supported by your browser.');
        return;
      }
      gpsBtn.textContent = 'Detecting GPS...';
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          currentCoords = { lat: pos.coords.latitude, lng: pos.coords.longitude };
          gpsBtn.textContent = '📍 GPS Active';
          loadDirectory();
        },
        () => {
          gpsBtn.textContent = '📍 Use My Live GPS';
          alert('Location access denied. Displaying stations for selected highway hub.');
        }
      );
    });

    loadDirectory();
  </script>
</body>
</html>
