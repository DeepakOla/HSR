const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LocalBusiness",
      "@id": "https://hsrgreenenergy.in/#station",
      "name": "HSR Green Energy CNG Cylinder Hydro Testing",
      "telephone": "+919910055355",
      "priceRange": "₹1,400 - ₹3,500",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Bhiwadi Road, Near Express Toll Plaza",
        "addressLocality": "Rewari",
        "addressRegion": "Haryana",
        "postalCode": "123401",
        "addressCountry": "IN"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 28.1950,
        "longitude": 76.6250
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
          "opens": "09:00",
          "closes": "18:00"
        }
      ]
    },
    {
      "@type": "Service",
      "name": "Automotive CNG Cylinder Hydrostatic Testing",
