      "serviceType": "CNG Cylinder Hydrostatic Stretch Testing",
      "areaServed": ["Rewari", "Gurugram", "Manesar", "Dharuhera", "Bhiwadi", "Pataudi", "Haryana"],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "CNG Cylinder Testing Packages",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Single Cylinder Car Hydro Testing (Maruti, Hyundai, Tata)"
            },
            "price": "1400",
            "priceCurrency": "INR"
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Dual Cylinder Vehicle Hydro Testing"
            },
            "price": "2600",
            "priceCurrency": "INR"
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Why is CNG cylinder hydro testing required every 3 years?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Under Rule 35 of the Gas Cylinders Rules (2016) and Central Motor Vehicles Rules (CMVR), all automotive CNG cylinders must undergo hydrostatic water-jacket expansion testing every 3 years to ensure structural integrity at 300 Bar pressure."
          }
        },
        {
          "@type": "Question",
          "name": "What is included in the ₹1,400 test fee?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The flat fee covers nitrogen degassing, ultrasonic wall-thickness scanning, 300 Bar water jacket stretch test, heated dry air baking, statutory brass compliance plate stamping, and digital PESO Form C certificate upload."
          }
        },
        {
          "@type": "Question",
          "name": "How long does the testing process take at HSR Rewari?",
          "acceptedAnswer": {
            "@type": "Answer",
