  <!-- Top bar scroll reveal script -->
  <script is:inline>
    (function() {
      const header = document.getElementById('top-sticky-header');
      if (header) {
        window.addEventListener('scroll', function() {
          if (window.scrollY > 280) {
            header.classList.add('revealed');
          } else {
            header.classList.remove('revealed');
          }
        }, { passive: true });
      }

      // Highway corridor coordinates
      const corridorHubs = {
        rewari: { lat: 28.1950, lng: 76.6250, name: 'Rewari Corridor (HSR Flagship)' },
        manesar: { lat: 28.3588, lng: 76.9425, name: 'IMT Manesar (NH-48)' },
        dharuhera: { lat: 28.2054, lng: 76.7946, name: 'Dharuhera / Bhiwadi Bypass' },
        gurugram: { lat: 28.4595, lng: 77.0266, name: 'Gurugram City Center' }
      };

      function calcDistanceKm(lat1, lon1, lat2, lon2) {
        const R = 6371;
        const dLat = (lat2 - lat1) * Math.PI / 180;
        const dLon = (lon2 - lon1) * Math.PI / 180;
        const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                  Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                  Math.sin(dLon/2) * Math.sin(dLon/2);
        return Math.round(R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a)) * 10) / 10;
      }

      function updateStationDistances(refLat, refLng, sourceLabel) {
        const container = document.getElementById('stations-card-container');
        const countLabel = document.getElementById('stations-count-label');
        if (!container) return;

        const cards = Array.from(container.querySelectorAll('.station-card'));
        cards.forEach(function(card) {
          const lat = parseFloat(card.getAttribute('data-lat') || '0');
          const lng = parseFloat(card.getAttribute('data-lng') || '0');
          if (lat && lng) {
            const dist = calcDistanceKm(refLat, refLng, lat, lng);
            card.setAttribute('data-distance', dist.toString());
            const badge = card.querySelector('.station-distance-badge');
            if (badge) badge.textContent = dist + ' km away';
          }
        });

        // Re-sort cards strictly by shortest road distance
        cards.sort(function(a, b) {
          const distA = parseFloat(a.getAttribute('data-distance') || '999');
          const distB = parseFloat(b.getAttribute('data-distance') || '999');
          return distA - distB;
        });

        cards.forEach(function(card) {
          container.appendChild(card);
        });

        if (countLabel) {
          countLabel.textContent = 'Showing ' + cards.length + ' PESO Stations • Nearest to ' + sourceLabel;
        }
      }

      const hubSelect = document.getElementById('station-hub-select');
      if (hubSelect) {
        hubSelect.addEventListener('change', function() {
          const hub = corridorHubs[hubSelect.value] || corridorHubs.rewari;
          updateStationDistances(hub.lat, hub.lng, hub.name);
        });
      }

      const gpsBtn = document.getElementById('station-gps-btn');
      if (gpsBtn) {
        gpsBtn.addEventListener('click', function() {
          if (!navigator.geolocation) {
            alert('Geolocation is not supported by your browser.');
            return;
          }
          gpsBtn.innerHTML = '<span>⏳</span> Locating...';
          navigator.geolocation.getCurrentPosition(
            function(pos) {
              gpsBtn.innerHTML = '<span>📍</span> GPS Active';
              updateStationDistances(pos.coords.latitude, pos.coords.longitude, 'your Live GPS Location');
            },
            function() {
              gpsBtn.innerHTML = '<span>📍</span> Use My Live GPS';
              alert('Location access denied. Displaying stations for selected highway corridor.');
            },
            { enableHighAccuracy: true, timeout: 8000 }
          );
        });
      }
    })();
  </script>
