---
// File: src/pages/cng/index.astro
// Comprehensive SEO Pillar Page: The Complete Guide to CNG Cylinder Hydrostatic Testing
import { getCollection } from 'astro:content';
import { getDb, getBusinessSettings } from '../../lib/db';
import { inr } from '../../lib/booking-wizard-helpers';
import FloatingWhatsApp from '../../components/FloatingWhatsApp.astro';
import '../../styles/design-tokens.css';

const db = getDb(Astro);
const settings = await getBusinessSettings(db);

const businessName = settings.business_name_en || 'HSR Green Energy';
const cityName = settings.city || 'Rewari';
const contactPhone = settings.contact_phone || '+919910055355';
const whatsappNumber = settings.whatsapp_number || '+919910055355';
const brandLogo = settings.brand_logo_url || '/images/hsr-gauge-logo.jpg';
const stationAddress = settings.address_line && settings.address_line !== 'SETUP_REQUIRED'
  ? settings.address_line
  : `${cityName} Industrial Corridor (NH-48), Haryana 123401`;
const advanceFormatted = inr(settings.flat_advance_paise || 50000);

const pageTitle = `CNG Cylinder Hydro Testing Guide India (PESO 3-Year Rule) | ${businessName}`;
const pageDescription = "Comprehensive authority guide on CNG cylinder hydrostatic stretch testing in India. Gas Cylinders Rules 2016 Rule 35, 3-year testing mandate, PESO Form C certification, 300 bar procedure, and avoiding pump refilling refusals.";
const canonicalUrl = "https://hsrgreenenergy.in/cng/";

// Fetch related blog articles
const allPosts = await getCollection('blog', ({ data }) => !data.draft && data.locale === 'en');
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const articles = allPosts.slice(0, 3);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Why is CNG cylinder hydrostatic testing mandatory every 3 years in India?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Under Rule 35 of the Gas Cylinders Rules (2016) and Bureau of Indian Standards IS 8451, all compressed natural gas (CNG) on-board vehicle cylinders must undergo high-pressure water-jacket hydrostatic stretch testing every 3 years to ensure structural integrity and prevent catastrophic rupture under 200 bar operating pressure."
      }
    },
    {
      "@type": "Question",
      "name": "Can a CNG pump refuse to fill gas if my hydro test certificate has expired?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Indian law and Petroleum and Explosives Safety Organization (PESO) regulations strictly prohibit fuel stations from dispensing CNG to any vehicle without an active, verified compliance plate affixed near the filling nozzle or in the engine bay. Fuel pumps face immediate license suspension if they dispense to expired cylinders."
      }
    },
    {
      "@type": "Question",
      "name": "How long does the CNG cylinder hydrostatic test take at a certified plant?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "At a Class-A PESO approved facility like HSR, testing takes between 90 minutes to 2 hours when booked in an express bay. The vehicle cylinder is degassed, placed in a 300-bar water jacket, dried, stamped with a new brass compliance plate, and issued an instant digital PESO Form C certificate."
      }
    },
    {
      "@type": "Question",
      "name": "What is the cost of CNG cylinder testing in Haryana and NCR?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `The statutory base rate is ₹2,500 per cylinder plus 18% GST (Total ₹2,950). Online reservations at HSR require only a flat ${advanceFormatted} advance to lock an express bay, with the balance payable upon certificate delivery.`
      }
    },
    {
      "@type": "Question",
      "name": "Can a local mechanic or CNG retrofit workshop issue a hydro test certificate?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Only authorized testing stations possessing a valid PESO Class-A Hydro Testing License equipped with calibrated water-jacket stretch testing apparatus are legally recognized. Certificates issued by roadside mechanics or unauthorized garages are invalid and rejected by transport authorities and fuel pumps."
      }
    }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": pageTitle,
  "description": pageDescription,
  "image": brandLogo,
  "author": {
    "@type": "Organization",
    "name": businessName
  },
  "publisher": {
    "@type": "Organization",
    "name": businessName,
    "logo": {
      "@type": "ImageObject",
      "url": brandLogo
    }
  },
  "datePublished": "2026-01-15T08:00:00Z",
  "dateModified": new Date().toISOString()
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/jpeg" href={brandLogo} />

  <!-- Open Graph -->
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content="article" />
  <meta property="og:image" content={brandLogo} />

  <!-- High-Performance Web Fonts (Inter & Plus Jakarta Sans with display=swap) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <style>
    :root {
      --font-heading: 'Plus Jakarta Sans', system-ui, sans-serif;
      --font-body: 'Inter', system-ui, sans-serif;
      --primary: #ea580c;
      --primary-dark: #c2410c;
      --navy: #0a1128;
      --navy-dark: #050b18;
