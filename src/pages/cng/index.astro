      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.25rem;
      margin: 1.75rem 0;
    }
    .step-card {
      background: #f8fafc;
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 1.25rem;
    }
    .step-num {
      display: inline-block;
      width: 28px;
      height: 28px;
      border-radius: 50%;
