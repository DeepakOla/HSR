      --slate-bg: #f8fafc;
      --border-color: #e2e8f0;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { font-family: var(--font-body); background: var(--slate-bg); color: #0f172a; line-height: 1.6; }

    /* Sticky Navigation Header */
    .pillar-header {
      background: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--border-color);
      padding: 0.75rem 1.25rem;
      position: sticky;
      top: 0;
      z-index: 50;
      box-shadow: 0 2px 6px rgba(0,0,0,0.06);
    }
    .header-inner {
      max-width: 1140px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .brand-link {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      text-decoration: none;
      color: var(--navy);
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 1.15rem;
    }
    .header-nav { display: flex; gap: 1rem; align-items: center; }
    .header-nav a { font-size: 0.85rem; font-weight: 600; color: #475569; text-decoration: none; }
    .header-nav a:hover { color: var(--primary); }
    .btn-header-cta {
      background: var(--primary);
      color: #fff !important;
      padding: 0.5rem 1rem;
      border-radius: 8px;
      font-weight: 700 !important;
      box-shadow: 0 2px 4px rgba(234, 88, 12, 0.3);
    }

    /* Hero Section */
    .pillar-hero {
      background: linear-gradient(135deg, #0a1128 0%, #1e293b 100%);
      color: #ffffff;
      padding: 4.5rem 1.25rem 3.5rem;
      text-align: center;
    }
    .hero-container { max-width: 880px; margin: 0 auto; }
    .hero-badge {
      display: inline-block;
      background: rgba(234, 88, 12, 0.2);
      border: 1px solid rgba(234, 88, 12, 0.45);
      color: #fb923c;
      font-size: 0.78rem;
      font-weight: 800;
      padding: 0.35rem 0.95rem;
      border-radius: 9999px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 1.25rem;
    }
    .hero-title {
      font-family: var(--font-heading);
      font-size: clamp(2rem, 4.5vw, 3rem);
      font-weight: 800;
      line-height: 1.25;
      letter-spacing: -0.02em;
      margin-bottom: 1.25rem;
    }
    .hero-subtitle {
      font-size: 1.15rem;
      color: #cbd5e1;
      max-width: 760px;
      margin: 0 auto 2rem;
      line-height: 1.6;
    }
    .hero-cta-group {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
    }
    .btn-primary-cta {
      background: var(--primary);
      color: #ffffff;
      font-weight: 800;
      font-size: 1rem;
      padding: 0.9rem 1.8rem;
      border-radius: 12px;
      text-decoration: none;
      box-shadow: 0 4px 14px rgba(234, 88, 12, 0.4);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    .btn-secondary-cta {
      background: #0284c7;
      color: #ffffff;
      font-weight: 700;
      font-size: 1rem;
      padding: 0.9rem 1.8rem;
      border-radius: 12px;
      text-decoration: none;
      box-shadow: 0 4px 14px rgba(2, 132, 199, 0.35);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    /* Content Layout */
    .pillar-layout {
      max-width: 1080px;
      margin: 3rem auto;
      padding: 0 1.25rem;
      display: grid;
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .content-article {
      background: #ffffff;
      border: 1px solid var(--border-color);
      border-radius: 20px;
      padding: 2.5rem 2rem;
      box-shadow: 0 4px 15px rgba(0,0,0,0.02);
    }
    .content-article h2 {
      font-family: var(--font-heading);
      font-size: 1.75rem;
      font-weight: 800;
      color: var(--navy);
      margin-top: 2.25rem;
      margin-bottom: 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 2px solid #f1f5f9;
    }
    .content-article h2:first-of-type { margin-top: 0; }
    .content-article h3 {
      font-family: var(--font-heading);
      font-size: 1.25rem;
      font-weight: 700;
      color: #1e293b;
      margin: 1.5rem 0 0.75rem;
    }
    .content-article p {
      font-size: 1.05rem;
      color: #334155;
      margin-bottom: 1.2rem;
      line-height: 1.75;
    }
