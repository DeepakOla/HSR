      font-weight: 800;
      text-align: center;
      line-height: 28px;
      margin-bottom: 0.75rem;
    }
    .step-card h4 {
      font-family: var(--font-heading);
      font-size: 1.05rem;
      font-weight: 700;
      color: #0f172a;
      margin-bottom: 0.5rem;
    }
    .step-card p {
      font-size: 0.9rem;
      color: #64748b;
      margin-bottom: 0;
      line-height: 1.5;
    }

    /* FAQ Accordion */
    .faq-list { margin-top: 1.5rem; }
    .faq-item {
      border: 1px solid var(--border-color);
      border-radius: 12px;
