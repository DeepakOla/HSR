---
import { requireRole } from '../../lib/auth';
import { getRuntimeEnv } from '../../lib/runtime-env';
import AdminLayout from '../../layouts/AdminLayout.astro';

const env = getRuntimeEnv(Astro.locals);
const auth = await requireRole(Astro.request, env, ['OWNER']);
if (!auth.ok) return auth.response;

let reminders: any[] = [];
let queueStats = { queued: 0, sent: 0, failed: 0 };

if (env?.DB) {
  try {
    const stats = await env.DB.prepare(`
      SELECT 
        SUM(CASE WHEN delivery_status = 'QUEUED' THEN 1 ELSE 0 END) as queued,
        SUM(CASE WHEN delivery_status = 'SENT' THEN 1 ELSE 0 END) as sent,
        SUM(CASE WHEN delivery_status = 'FAILED' THEN 1 ELSE 0 END) as failed
      FROM reminder_schedules
    `).first<any>();

    if (stats) {
      queueStats.queued = stats.queued || 0;
      queueStats.sent = stats.sent || 0;
      queueStats.failed = stats.failed || 0;
    }

    const rows = await env.DB.prepare(`
      SELECT r.id, r.reminder_type as reminderType, r.scheduled_for as scheduledFor,
             r.channel, r.delivery_status as status, r.sent_at as sentAt,
             p.full_name as customerName,
             cp.display_phone as phone,
             COALESCE(v.registration_display, v.registration_normalized, 'HR-26') as regNo
      FROM reminder_schedules r
      LEFT JOIN parties p ON p.id = r.party_id
      LEFT JOIN contact_phones cp ON cp.id = r.phone_id
      LEFT JOIN vehicles v ON v.id = r.vehicle_id
      ORDER BY r.scheduled_for DESC LIMIT 50
    `).all<any>();
    reminders = rows.results || [];
  } catch (e) {
    console.error('Failed to query reminders:', e);
  }
}
---

<AdminLayout title="Customer Reminders & Notifications" owner={true} activeNav="reminders">
  <div class="admin-app">
    <!-- Header -->
    <div class="admin-heading">
      <div>
        <p class="admin-eyebrow">AUTOMATED WHATSAPP & SMS NOTIFICATIONS</p>
        <h1>Customer Retest Reminder Queue</h1>
        <p class="admin-subtitle">
          Monitor statutory compliance alerts, day-before appointment reminders, PESO certificate readiness, and 3-year cylinder retest expiry notifications.
        </p>
      </div>

      <div class="admin-actions">
        <a href="/admin/owner/" class="admin-button secondary">
          ⚙️ Reminder Alert Settings
        </a>
      </div>
    </div>

    <!-- Metrics -->
    <div class="admin-metrics">
      <div class="admin-card">
        <div class="admin-metric-label">Queued for Delivery</div>
        <div class="admin-metric-value text-steel">{queueStats.queued}</div>
        <div class="admin-metric-note">Scheduled dispatch window</div>
      </div>
      <div class="admin-card">
        <div class="admin-metric-label">Successfully Delivered</div>
        <div class="admin-metric-value text-pass">{queueStats.sent}</div>
        <div class="admin-metric-note">Sent via WhatsApp / SMS</div>
      </div>
      <div class="admin-card">
        <div class="admin-metric-label">Delivery Failures</div>
        <div class="admin-metric-value text-warn">{queueStats.failed}</div>
        <div class="admin-metric-note">Unreachable phone numbers</div>
      </div>
    </div>

    <!-- Log Table -->
    <section class="admin-card">
      <h2 class="admin-section-title">Scheduled Notifications Log</h2>

      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Recipient</th>
              <th>Vehicle Reg</th>
              <th>Reminder Type</th>
              <th>Channel</th>
              <th>Scheduled For</th>
              <th>Delivery Status</th>
            </tr>
          </thead>
          <tbody>
            {reminders.length === 0 ? (
              <tr>
                <td colspan="6" class="table-empty-cell">
                  No customer reminder notifications scheduled yet.
                </td>
              </tr>
            ) : (
              reminders.map((r) => (
                <tr>
                  <td>
                    <strong>{r.customerName || 'Customer'}</strong>
                    <div class="font-mono-col text-steel">
                      {r.phone ? `+91 ${r.phone}` : '—'}
                    </div>
                  </td>
                  <td>
                    <span class="reg-pill">{r.regNo}</span>
                  </td>
                  <td>
                    <span class="admin-tag">{r.reminderType}</span>
                  </td>
                  <td class="font-bold text-steel">
                    {r.channel}
                  </td>
                  <td class="font-mono-col">
                    {r.scheduledFor?.slice(0, 16).replace('T', ' ')}
                  </td>
                  <td>
                    <span class={`admin-status ${
                      r.status === 'SENT' ? '' :
                      r.status === 'QUEUED' ? 'pending' : 'error'
                    }`}>
                      {r.status}
                    </span>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</AdminLayout>

<style>
  .reg-pill {
    display: inline-block;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    background: #0a1128;
    color: #ffffff;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.03em;
  }

  .font-mono-col {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
  }

  .font-bold {
    font-weight: 700;
  }

  .text-steel {
    color: #0284c7 !important;
  }

  .text-pass {
    color: #15803d !important;
  }

  .text-warn {
    color: #ea580c !important;
  }

  .table-empty-cell {
    text-align: center;
    padding: 2.5rem 1rem !important;
    color: #94a3b8;
  }
</style>
