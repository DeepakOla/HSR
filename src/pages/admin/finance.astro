---
import { requireRole } from '../../lib/auth';
import { getRuntimeEnv } from '../../lib/runtime-env';
import AdminLayout from '../../layouts/AdminLayout.astro';

const env = getRuntimeEnv(Astro.locals);
const auth = await requireRole(Astro.request, env, ['OWNER']);
if (!auth.ok) return auth.response;

let payments: any[] = [];
let totals = {
  totalPaidPaise: 0,
  upiPaise: 0,
  cashPaise: 0,
  verifiedCount: 0,
  pendingCount: 0,
};

if (env?.DB) {
  try {
    const stats = await env.DB.prepare(`
      SELECT 
        SUM(amount_paise) as totalPaid,
        SUM(CASE WHEN payment_mode = 'UPI_QR' THEN amount_paise ELSE 0 END) as upiTotal,
        SUM(CASE WHEN payment_mode = 'CASH' THEN amount_paise ELSE 0 END) as cashTotal,
        SUM(CASE WHEN payment_state = 'VERIFIED' THEN 1 ELSE 0 END) as verifiedCount,
        SUM(CASE WHEN payment_state = 'PENDING_VERIFICATION' THEN 1 ELSE 0 END) as pendingCount
      FROM payments
    `).first<any>();

    if (stats) {
      totals.totalPaidPaise = stats.totalPaid || 0;
      totals.upiPaise = stats.upiTotal || 0;
      totals.cashPaise = stats.cashTotal || 0;
      totals.verifiedCount = stats.verifiedCount || 0;
      totals.pendingCount = stats.pendingCount || 0;
    }

    const rows = await env.DB.prepare(`
      SELECT p.id, p.booking_group_id as groupId, p.amount_paise as amountPaise,
             p.payment_mode as mode, p.utr_or_reference as utr, p.payment_state as state,
             p.paid_at as paidAt, p.verified_at as verifiedAt,
             b.booking_code as bookingCode,
             COALESCE(b.display_reg_no, v.registration_display, 'HR-26') as regNo
      FROM payments p
      LEFT JOIN bookings b ON b.id = p.booking_id
      LEFT JOIN vehicles v ON v.id = b.vehicle_id
      ORDER BY p.paid_at DESC LIMIT 50
    `).all<any>();
    payments = rows.results || [];
  } catch (e) {
    console.error('Failed to query payments ledger:', e);
  }
}
---

<AdminLayout title="Financial Reconciliation & Ledger" owner={true} activeNav="finance">
  <div class="admin-app">
    <!-- Header -->
    <div class="admin-heading">
      <div>
        <p class="admin-eyebrow">FINANCIAL ACCOUNTING & COUNTER RECONCILIATION</p>
        <h1>Payments & Revenue Ledger</h1>
        <p class="admin-subtitle">
          Real-time statutory accounting ledger. Track cash receipts, 12-digit UPI UTR settlements, and verified online advances.
        </p>
      </div>

      <div class="admin-actions">
        <a href="/api/admin/exports/bookings.csv" class="admin-button secondary">
          📥 Export Accounting CSV
        </a>
      </div>
    </div>

    <!-- Financial KPI Metrics -->
    <div class="admin-metrics">
      <div class="admin-card">
        <div class="admin-metric-label">Total Collections</div>
        <div class="admin-metric-value">₹{(totals.totalPaidPaise / 100).toLocaleString('en-IN')}</div>
        <div class="admin-metric-note">Verified: {totals.verifiedCount} • Pending: {totals.pendingCount}</div>
      </div>

      <div class="admin-card">
        <div class="admin-metric-label">UPI Online Settlements</div>
        <div class="admin-metric-value text-steel">₹{(totals.upiPaise / 100).toLocaleString('en-IN')}</div>
        <div class="admin-metric-note">QR & VPA direct payments</div>
      </div>

      <div class="admin-card">
        <div class="admin-metric-label">Cash Drawer</div>
        <div class="admin-metric-value text-pass">₹{(totals.cashPaise / 100).toLocaleString('en-IN')}</div>
        <div class="admin-metric-note">Counter cash received</div>
      </div>

      <div class="admin-card">
        <div class="admin-metric-label">Pending Verification</div>
        <div class="admin-metric-value text-warn">{totals.pendingCount}</div>
        <div class="admin-metric-note">Requires UTR reconciliation</div>
      </div>
    </div>

    <!-- Payments Ledger Table -->
    <section class="admin-card">
      <h2 class="admin-section-title">Recent Payment Transactions</h2>

      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Date / Time</th>
              <th>Vehicle / Booking</th>
              <th>Mode</th>
              <th>Reference / UTR</th>
              <th>Amount</th>
              <th>Payment State</th>
            </tr>
          </thead>
          <tbody>
            {payments.length === 0 ? (
              <tr>
                <td colspan="6" class="table-empty-cell">
                  No payment transactions recorded yet.
                </td>
              </tr>
            ) : (
              payments.map((p) => (
                <tr>
                  <td class="font-mono-col">
                    {p.paidAt ? new Date(p.paidAt).toLocaleString('en-IN') : '—'}
                  </td>
                  <td>
                    <span class="reg-pill">{p.regNo || p.bookingCode || '—'}</span>
                  </td>
                  <td>
                    <span class="admin-tag">{p.mode}</span>
                  </td>
                  <td class="font-mono-col text-steel">
                    {p.utr || '—'}
                  </td>
                  <td class="font-mono-col font-bold">
                    ₹{(p.amountPaise / 100).toLocaleString('en-IN')}
                  </td>
                  <td>
                    <span class={`admin-status ${p.state === 'VERIFIED' ? '' : 'pending'}`}>
                      {p.state}
                    </span>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</AdminLayout>

<style>
  .reg-pill {
    display: inline-block;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    background: #0a1128;
    color: #ffffff;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.03em;
  }

  .font-mono-col {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
  }

  .font-bold {
    font-weight: 700;
  }

  .text-steel {
    color: #0284c7 !important;
  }

  .text-pass {
    color: #15803d !important;
  }

  .text-warn {
    color: #ea580c !important;
  }

  .table-empty-cell {
    text-align: center;
    padding: 2.5rem 1rem !important;
    color: #94a3b8;
  }
</style>
