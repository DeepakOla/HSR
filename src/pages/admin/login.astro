---
// File: src/pages/admin/login.astro
import '../../styles/design-tokens.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta http-equiv="refresh" content="0;url=/login/?role=staff" />
    <title>Redirecting to Unified Sign-In Portal | HSR Green Energy</title>
  </head>
  <body>
    <div style="max-width: 500px; margin: 4rem auto; text-align: center; font-family: system-ui, sans-serif;">
      <h2>Redirecting to Unified Portal...</h2>
      <p>If not redirected automatically, please <a href="/login/?role=staff">click here to sign in</a>.</p>
      <div style="margin-top: 2rem; display: flex; gap: 1rem; justify-content: center;">
        <a href="/admin/reception/" class="portal-link">Reception Desk</a>
        <a href="/admin/owner/" class="portal-link">Owner Console</a>
      </div>
    </div>
    <script>
      window.location.href = '/login/?role=staff';
    </script>
  </body>
</html>
