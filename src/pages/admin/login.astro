---
import { getDb, getBusinessSettings } from '../../lib/db';

const db = getDb(Astro);
const settings = await getBusinessSettings(db);
const rawLocale = Astro.url.searchParams.get('locale');
const locale = rawLocale === 'hi' ? 'hi' : 'en';
const hindi = locale === 'hi';
const businessName = hindi ? (settings.business_name_hi || settings.business_name_en || 'HSR') : (settings.business_name_en || 'HSR');
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{hindi ? `साइन-इन एवं एक्सेस पोर्टल | ${businessName}` : `Authentication & Access Portal | ${businessName}`}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/src/styles/design-tokens.css" />
    <style>
      body {
        margin: 0;
        font-family: var(--font-sans, system-ui, sans-serif);
        background: #f8fafc;
        color: #0f172a;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      .login-container {
        max-width: 960px;
        margin: 3rem auto;
        padding: 0 1.5rem;
        flex: 1;
      }
      .login-top-bar {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 1rem;
      }
      .lang-switch-btn {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        padding: 0.35rem 0.75rem;
        font-size: 0.85rem;
        font-weight: 600;
        color: #0284c7;
        text-decoration: none;
        transition: all 0.15s ease;
      }
      .lang-switch-btn:hover {
        background: #eff6ff;
        border-color: #0284c7;
      }
      .login-header {
        text-align: center;
        margin-bottom: 2.5rem;
      }
      .login-brand-tag {
        display: inline-block;
        background: #e0f2fe;
        color: #0284c7;
        font-weight: 700;
        font-size: 0.8rem;
        padding: 0.25rem 0.75rem;
        border-radius: 9999px;
        text-transform: uppercase;
        margin-bottom: 0.5rem;
      }
      .login-title {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: clamp(1.8rem, 3vw, 2.3rem);
        color: #0a1128;
        margin: 0.25rem 0 0.5rem;
        letter-spacing: -0.02em;
      }
      .login-subtitle {
        color: #475569;
        font-size: 1rem;
        max-width: 580px;
        margin: 0 auto;
      }
      .portals-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2.5rem;
      }
      .portal-card {
        background: #ffffff;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        padding: 1.75rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        transition: all 0.2s ease;
      }
      .portal-card:hover {
        border-color: #0284c7;
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.08);
      }
      .portal-badge {
        font-size: 0.75rem;
        font-weight: 700;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        display: inline-block;
        width: fit-content;
        margin-bottom: 0.75rem;
      }
      .badge-customer { background: #f0fdf4; color: #15803d; }
      .badge-staff { background: #eff6ff; color: #1d4ed8; }
      .badge-admin { background: #fff7ed; color: #c2410c; }
      .portal-name {
        font-size: 1.25rem;
        font-weight: 700;
        color: #0a1128;
        margin: 0 0 0.5rem;
      }
      .portal-desc {
        color: #64748b;
        font-size: 0.88rem;
        line-height: 1.5;
        margin-bottom: 1.5rem;
        flex: 1;
      }
      .portal-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        background: #0a1128;
        color: #ffffff;
        font-weight: 600;
        font-size: 0.9rem;
        padding: 0.75rem 1rem;
        border-radius: 6px;
        text-decoration: none;
        transition: background 0.15s ease;
      }
      .portal-btn:hover {
        background: #ea580c;
      }
      .portal-btn-secondary {
        background: #0284c7;
      }
      .portal-btn-secondary:hover {
        background: #0369a1;
      }
      .security-notice-box {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        padding: 1.25rem 1.5rem;
        font-size: 0.85rem;
        color: #475569;
        line-height: 1.5;
      }
      .back-home-link {
        display: inline-block;
        margin-top: 1.5rem;
        color: #0284c7;
        text-decoration: none;
        font-weight: 600;
      }
      .back-home-link:hover {
        text-decoration: underline;
      }
    </style>
  </head>
  <body>
    <main class="login-container">
      <div class="login-top-bar">
        <a href={hindi ? '/admin/login/?locale=en' : '/admin/login/?locale=hi'} class="lang-switch-btn">
          🌐 {hindi ? 'English' : 'हिंदी'}
        </a>
      </div>

      <div class="login-header">
        <span class="login-brand-tag">⚡ {businessName} {hindi ? 'एक्सेस पोर्टल' : 'Access Portal'}</span>
        <h1 class="login-title">{hindi ? 'एचएसआर सिस्टम में साइन-इन करें' : 'Sign in to HSR Systems'}</h1>
        <p class="login-subtitle">
          {hindi
            ? 'नीचे अपना गंतव्य पोर्टल चुनें। स्टाफ एवं एडमिनिस्ट्रेटिव सिस्टम क्लाउडफ्लेयर एक्सेस सुरक्षा द्वारा सुरक्षित हैं।'
            : 'Select your destination portal below. Staff and administrative systems are secured with Cloudflare Access zero-trust identity verification.'}
        </p>
      </div>

      <div class="portals-grid">
        <!-- Portal 1: Customer Portal -->
        <div class="portal-card">
          <div>
            <span class="portal-badge badge-customer">🚗 {hindi ? 'ग्राहक स्वयं-सेवा' : 'Customer Self-Service'}</span>
            <h2 class="portal-name">{hindi ? 'ग्राहक पोर्टल' : 'Customer Portal'}</h2>
            <p class="portal-desc">
              {hindi
                ? 'अपने वाहन सिलेंडर टेस्टिंग की लाइव स्थिति देखें, अपॉइंटमेंट ट्रैक करें या रजिस्ट्रेशन नंबर से प्रमाणपत्र विवरण प्राप्त करें।'
                : 'Check your vehicle cylinder testing status, view upcoming appointments, track booking progress, or view certificate records using your vehicle registration number.'}
            </p>
          </div>
          <a href={hindi ? '/hi/status/' : '/en/status/'} class="portal-btn">
            🔍 {hindi ? 'बुकिंग एवं वाहन स्थिति जाँचें →' : 'Check Booking & Vehicle Status →'}
          </a>
        </div>

        <!-- Portal 2: Staff Console (Receptionist & Inspection Desk) -->
        <div class="portal-card">
          <div>
            <span class="portal-badge badge-staff">📋 {hindi ? 'स्टाफ एवं संचालन' : 'Staff & Operations'}</span>
            <h2 class="portal-name">{hindi ? 'स्टाफ डेस्क (रिसेप्शन)' : 'Staff Desk (Reception)'}</h2>
            <p class="portal-desc">
              {hindi
                ? 'वाहनों का आगमन, सिलेंडर रजिस्टर में प्रविष्टि, ऑनलाइन यूटीआर भुगतान सत्यापन एवं टेस्टिंग बे का आवंटन करें।'
                : 'Manage vehicle arrivals, register cylinders into the official test register, verify customer UTR payment references, and allocate testing bays.'}
            </p>
          </div>
          <a href="/admin/reception/" class="portal-btn portal-btn-secondary">
            📋 {hindi ? 'रिसेप्शन डेस्क खोलें →' : 'Open Reception Desk →'}
          </a>
        </div>

        <!-- Portal 3: Admin Console (Owner Settings & Schedules) -->
        <div class="portal-card">
          <div>
            <span class="portal-badge badge-admin">⚙️ {hindi ? 'प्रबंधन एवं सेटिंग्स' : 'Management & Settings'}</span>
            <h2 class="portal-name">{hindi ? 'ओनर कंसोल' : 'Owner Console'}</h2>
            <p class="portal-desc">
              {hindi
                ? 'व्यवसाय विवरण, प्रति-सिलेंडर दरें, साप्ताहिक बे क्षमता, तारीख अवकाश, स्टाफ अनुमतियाँ व रीटेस्ट रिमाइंडर प्रबंधित करें।'
                : 'Configure business details, per-cylinder pricing rates, weekly bay schedule capacity, date overrides, staff user permissions, and retest reminders.'}
            </p>
          </div>
          <a href="/admin/owner/" class="portal-btn">
            ⚙️ {hindi ? 'ओनर कंसोल खोलें →' : 'Open Owner Console →'}
          </a>
        </div>
      </div>

      <div class="security-notice-box">
        <strong>🛡️ {hindi ? 'जीरो-ट्रस्ट सुरक्षा प्रणाली:' : 'Zero-Trust Security Architecture:'}</strong>{' '}
        {hindi
          ? 'स्टाफ और प्रशासक खातों को क्लाउडफ्लेयर एक्सेस के माध्यम से ईमेल सत्यापन की आवश्यकता होती है। यदि आप अधिकृत कर्मचारी हैं और प्रवेश नहीं कर पा रहे हैं, तो कृपया स्टेशन स्वामी से संपर्क करें।'
          : 'Staff and Administrator accounts require authenticated email verification through Cloudflare Access. If you are a staff technician or manager and cannot access your console, please contact the station owner to ensure your email is enrolled in the staff user directory.'}
      </div>

      <div style="text-align: center;">
        <a href={hindi ? '/hi/' : '/en/'} class="back-home-link">
          ← {hindi ? 'मुख्य पृष्ठ पर वापस जाएँ' : 'Return to Public Homepage'}
        </a>
      </div>
    </main>
  </body>
</html>
