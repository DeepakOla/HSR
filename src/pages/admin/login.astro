---
import { getDb, getBusinessSettings } from '../../lib/db';

const db = getDb(Astro);
const settings = await getBusinessSettings(db);
const businessName = settings.business_name_en || 'HSR';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Authentication & Access Portal | {businessName}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/src/styles/design-tokens.css" />
    <style>
      body {
        margin: 0;
        font-family: var(--font-sans, system-ui, sans-serif);
        background: #f8fafc;
        color: #0f172a;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      .login-container {
        max-width: 960px;
        margin: 3rem auto;
        padding: 0 1.5rem;
        flex: 1;
      }
      .login-header {
        text-align: center;
        margin-bottom: 2.5rem;
      }
      .login-brand-tag {
        display: inline-block;
        background: #e0f2fe;
        color: #0284c7;
        font-weight: 700;
        font-size: 0.8rem;
        padding: 0.25rem 0.75rem;
        border-radius: 9999px;
        text-transform: uppercase;
        margin-bottom: 0.5rem;
      }
      .login-title {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: clamp(1.8rem, 3vw, 2.3rem);
        color: #0a1128;
        margin: 0.25rem 0 0.5rem;
        letter-spacing: -0.02em;
      }
      .login-subtitle {
        color: #475569;
        font-size: 1rem;
        max-width: 580px;
        margin: 0 auto;
      }
      .portals-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2.5rem;
      }
      .portal-card {
        background: #ffffff;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        padding: 1.75rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        transition: all 0.2s ease;
      }
      .portal-card:hover {
        border-color: #2563eb;
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.08);
      }
      .portal-badge {
        font-size: 0.75rem;
        font-weight: 700;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        display: inline-block;
        width: fit-content;
        margin-bottom: 0.75rem;
      }
      .badge-customer { background: #f0fdf4; color: #15803d; }
      .badge-staff { background: #eff6ff; color: #1d4ed8; }
      .badge-admin { background: #fff7ed; color: #c2410c; }
      .portal-name {
        font-size: 1.25rem;
        font-weight: 700;
        color: #0a1128;
        margin: 0 0 0.5rem;
      }
      .portal-desc {
        color: #64748b;
        font-size: 0.88rem;
        line-height: 1.5;
        margin-bottom: 1.5rem;
        flex: 1;
      }
      .portal-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        background: #0a1128;
        color: #ffffff;
        font-weight: 600;
        font-size: 0.9rem;
        padding: 0.75rem 1rem;
        border-radius: 6px;
        text-decoration: none;
        transition: background 0.15s ease;
      }
      .portal-btn:hover {
        background: #ea580c;
      }
      .portal-btn-secondary {
        background: #2563eb;
      }
      .portal-btn-secondary:hover {
        background: #1d4ed8;
      }
      .security-notice-box {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        padding: 1.25rem 1.5rem;
        font-size: 0.85rem;
        color: #475569;
        line-height: 1.5;
      }
      .back-home-link {
        display: inline-block;
        margin-top: 1.5rem;
        color: #2563eb;
        text-decoration: none;
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <main class="login-container">
      <div class="login-header">
        <span class="login-brand-tag">⚡ {businessName} Access Portal</span>
        <h1 class="login-title">Sign in to HSR Systems</h1>
        <p class="login-subtitle">
          Select your destination portal below. Staff and administrative systems are secured with Cloudflare Access zero-trust identity verification.
        </p>
      </div>

      <div class="portals-grid">
        <!-- Portal 1: Customer Portal -->
        <div class="portal-card">
          <div>
            <span class="portal-badge badge-customer">🚗 Customer Self-Service</span>
            <h2 class="portal-name">Customer Portal</h2>
            <p class="portal-desc">
              Check your vehicle cylinder testing status, view upcoming appointments, track booking progress, or download compliance certificates using your vehicle registration number.
            </p>
          </div>
          <a href="/en/status/" class="portal-btn">
            🔍 Check Booking & Vehicle Status →
          </a>
        </div>

        <!-- Portal 2: Staff Console (Receptionist & Inspection Desk) -->
        <div class="portal-card">
          <div>
            <span class="portal-badge badge-staff">📋 Staff & Operations</span>
            <h2 class="portal-name">Staff Desk (Reception)</h2>
            <p class="portal-desc">
              Manage vehicle arrivals, register cylinders into the official test register, verify customer UTR payment references, and allocate testing bays.
            </p>
          </div>
          <a href="/admin/reception/" class="portal-btn portal-btn-secondary">
            📋 Open Reception Desk →
          </a>
        </div>

        <!-- Portal 3: Admin Console (Owner Settings & Schedules) -->
        <div class="portal-card">
          <div>
            <span class="portal-badge badge-admin">⚙️ Management & Settings</span>
            <h2 class="portal-name">Owner Console</h2>
            <p class="portal-desc">
              Configure business details, per-cylinder pricing rates, weekly bay schedule capacity, date overrides, staff user permissions, and audit logs.
            </p>
          </div>
          <a href="/admin/owner/" class="portal-btn">
            ⚙️ Open Owner Console →
          </a>
        </div>
      </div>

      <div class="security-notice-box">
        <strong>🛡️ Zero-Trust Security Architecture:</strong>
        Staff and Administrator accounts require authenticated email verification through Cloudflare Access. If you are a staff technician or manager and cannot access your console, please contact the station owner to ensure your email is enrolled in the staff user directory.
      </div>

      <div style="text-align: center;">
        <a href="/en/" class="back-home-link">← Return to Public Homepage</a>
      </div>
    </main>
  </body>
</html>
