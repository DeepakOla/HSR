---
import { requireRole } from '../../lib/auth';
import { getRuntimeEnv } from '../../lib/runtime-env';
import AdminLayout from '../../layouts/AdminLayout.astro';

const env = getRuntimeEnv(Astro.locals);
const auth = await requireRole(Astro.request, env, ['OWNER', 'RECEPTIONIST']);
if (!auth.ok) return auth.response;

const isOwner = auth.staff.role === 'OWNER';

// Today's date in IST
const today = new Intl.DateTimeFormat('en-CA', {
  timeZone: 'Asia/Kolkata',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(new Date());

let metrics = {
  todayBookings: 0,
  webBookings: 0,
  walkinBookings: 0,
  inProgress: 0,
  completed: 0,
  passedCylinders: 0,
  condemnedCylinders: 0,
  totalRevenuePaise: 0,
  pendingRevenuePaise: 0,
};

let resources: any[] = [];
let recentBookings: any[] = [];

if (env?.DB) {
  try {
    // 1. Booking counts for today
    const bookingStats = await env.DB.prepare(`
      SELECT 
        COUNT(*) as total,
        SUM(CASE WHEN source = 'WEB' THEN 1 ELSE 0 END) as webCount,
        SUM(CASE WHEN source != 'WEB' THEN 1 ELSE 0 END) as walkinCount,
        SUM(CASE WHEN reservation_state IN ('CHECKED_IN', 'IN_PROGRESS') OR testing_status IN ('IN_BAY_INTAKE', 'HYDRO_TESTING') THEN 1 ELSE 0 END) as inProgressCount,
        SUM(CASE WHEN reservation_state = 'CONFIRMED' AND (testing_status = 'RELEASED' OR booking_status = 'COMPLETED') THEN 1 ELSE 0 END) as completedCount,
        SUM(COALESCE(amount_paid_paise, 0)) as totalRevenue,
        SUM(COALESCE(balance_paise_snapshot, 0)) as pendingRevenue
      FROM bookings
      WHERE service_date = ? OR slot_date = ?
    `).bind(today, today).first<any>();

    if (bookingStats) {
      metrics.todayBookings = bookingStats.total || 0;
      metrics.webBookings = bookingStats.webCount || 0;
      metrics.walkinBookings = bookingStats.walkinCount || 0;
      metrics.inProgress = bookingStats.inProgressCount || 0;
      metrics.completed = bookingStats.completedCount || 0;
      metrics.totalRevenuePaise = bookingStats.totalRevenue || 0;
      metrics.pendingRevenuePaise = bookingStats.pendingRevenue || 0;
    }

    // 2. Tested cylinder stats
    const cylStats = await env.DB.prepare(`
      SELECT 
        SUM(CASE WHEN current_status = 'ACTIVE' THEN 1 ELSE 0 END) as passedCount,
        SUM(CASE WHEN current_status = 'CONDEMNED' THEN 1 ELSE 0 END) as condemnedCount
      FROM cylinders
      WHERE date(created_at) = date('now')
    `).first<any>();

    if (cylStats) {
      metrics.passedCylinders = cylStats.passedCount || 0;
      metrics.condemnedCylinders = cylStats.condemnedCount || 0;
    }

    // 3. Station Resource Status
    const resRows = await env.DB.prepare(`
      SELECT resource_code as resourceCode, resource_name as resourceName,
             resource_type as resourceType, status
      FROM station_resources
      ORDER BY resource_code ASC LIMIT 10
    `).all<any>();
    resources = resRows.results || [];

    // 4. Recent bookings
    const recentRows = await env.DB.prepare(`
      SELECT 
        b.booking_code as bookingCode,
        COALESCE(b.display_reg_no, v.registration_display, 'HR-26') as regNo,
        b.slot_start_time as slotTime,
        b.cylinder_count as cylinderCount,
        b.total_price_paise as totalPricePaise,
        b.reservation_state as reservationState,
        COALESCE(b.testing_status, 'SCHEDULED') as testingStatus
      FROM bookings b
      LEFT JOIN vehicles v ON v.id = b.vehicle_id
      ORDER BY b.created_at DESC LIMIT 6
    `).all<any>();
    recentBookings = recentRows.results || [];
  } catch (err) {
    console.error('Failed to query admin dashboard:', err);
  }
}
---

<AdminLayout title="Station Executive Overview" owner={isOwner} activeNav="overview">
  <div class="admin-app">
    <!-- Header -->
    <div class="admin-heading">
      <div>
        <p class="admin-eyebrow">OPERATIONS & MANAGEMENT CONSOLE</p>
        <h1>Station Executive Overview</h1>
        <p class="admin-subtitle">
          Live telemetry and operational monitoring for Rewari Hydro Testing Facility • Date: <strong>{today}</strong>
        </p>
      </div>

      <div class="admin-actions">
        <a href="/admin/reception/" class="admin-button">
          📋 Reception Queue →
        </a>
        {isOwner && (
          <a href="/admin/owner/" class="admin-button secondary">
            ⚙️ Owner Settings
          </a>
        )}
      </div>
    </div>

    <!-- KPI Metrics Ribbon -->
    <div class="admin-metrics">
      <div class="admin-card">
        <div class="admin-metric-label">Today's Appointments</div>
        <div class="admin-metric-value">{metrics.todayBookings}</div>
        <div class="admin-metric-note">🌐 Web: {metrics.webBookings} • 🚶 Desk: {metrics.walkinBookings}</div>
      </div>

      <div class="admin-card">
        <div class="admin-metric-label">Active In Bays</div>
        <div class="admin-metric-value text-steel">{metrics.inProgress}</div>
        <div class="admin-metric-note">Under test or intake</div>
      </div>

      <div class="admin-card">
        <div class="admin-metric-label">Completed Tests</div>
        <div class="admin-metric-value text-pass">{metrics.completed}</div>
        <div class="admin-metric-note">Passed: {metrics.passedCylinders} {metrics.condemnedCylinders > 0 ? `• Condemned: ${metrics.condemnedCylinders}` : ''}</div>
      </div>

      <div class="admin-card">
        <div class="admin-metric-label">Revenue Collected</div>
        <div class="admin-metric-value">₹{(metrics.totalRevenuePaise / 100).toLocaleString('en-IN')}</div>
        <div class="admin-metric-note">Pending counter: ₹{(metrics.pendingRevenuePaise / 100).toLocaleString('en-IN')}</div>
      </div>
    </div>

    <!-- Main 2-Column Grid -->
    <div class="overview-grid">
      <!-- Recent Bookings Table -->
      <section class="admin-card">
        <div class="overview-card-head">
          <h2 class="admin-section-title">Recent Testing Appointments</h2>
          <a href="/admin/reception/" class="quick-link">View Full Desk →</a>
        </div>

        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Vehicle Reg</th>
                <th>Time Slot</th>
                <th>Cylinders</th>
                <th>Amount</th>
                <th>Booking Status</th>
                <th>Testing Progress</th>
              </tr>
            </thead>
            <tbody>
              {recentBookings.length === 0 ? (
                <tr>
                  <td colspan="6" class="table-empty-cell">
                    No bookings recorded yet for this session.
                  </td>
                </tr>
              ) : (
                recentBookings.map((b) => (
                  <tr>
                    <td>
                      <span class="reg-pill">{b.regNo}</span>
                    </td>
                    <td class="font-mono-col">{b.slotTime}</td>
                    <td>{b.cylinderCount} Cyl</td>
                    <td class="font-mono-col font-bold">
                      ₹{(b.totalPricePaise / 100).toLocaleString('en-IN')}
                    </td>
                    <td>
                      <span class={`admin-status ${b.reservationState === 'CONFIRMED' ? '' : 'pending'}`}>
                        {b.reservationState}
                      </span>
                    </td>
                    <td>
                      <span class="telemetry-chip">{b.testingStatus}</span>
                    </td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Equipment Status Card -->
      <section class="admin-card">
        <div class="overview-card-head">
          <h2 class="admin-section-title">Bays & Equipment</h2>
          {isOwner && <a href="/admin/bays-equipment/" class="quick-link">Manage →</a>}
        </div>

        <div class="equipment-list">
          {resources.length === 0 ? (
            <p class="text-muted-col">No resources configured.</p>
          ) : (
            resources.map((res) => (
              <div class="equipment-row">
                <div>
                  <strong class="equipment-name">{res.resourceName}</strong>
                  <span class="equipment-code">Code: <code>{res.resourceCode}</code> • {res.resourceType}</span>
                </div>
                <span class={`admin-status ${res.status === 'ONLINE' ? '' : res.status === 'OCCUPIED' ? 'pending' : 'error'}`}>
                  {res.status}
                </span>
              </div>
            ))
          )}
        </div>
      </section>
    </div>
  </div>
</AdminLayout>

<style>
  .overview-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  @media (max-width: 1024px) {
    .overview-grid {
      grid-template-columns: 1fr;
    }
  }

  .overview-card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #f1f5f9;
  }

  .overview-card-head .admin-section-title {
    margin: 0;
  }

  .quick-link {
    font-size: 0.82rem;
    font-weight: 700;
    color: #0284c7;
    text-decoration: none;
  }

  .quick-link:hover {
    text-decoration: underline;
  }

  .reg-pill {
    display: inline-block;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    background: #0a1128;
    color: #ffffff;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.03em;
  }

  .font-mono-col {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
  }

  .font-bold {
    font-weight: 700;
  }

  .text-steel {
    color: #0284c7 !important;
  }

  .text-pass {
    color: #15803d !important;
  }

  .telemetry-chip {
    display: inline-block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    font-weight: 700;
    color: #0284c7;
    background: #f0f9ff;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    border: 1px solid #bae6fd;
  }

  .table-empty-cell {
    text-align: center;
    padding: 2.5rem 1rem !important;
    color: #94a3b8;
  }

  .equipment-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .equipment-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem;
    background: #f8fafc;
    border-radius: 8px;
    border: 1px solid #e2e8f0;
  }

  .equipment-name {
    display: block;
    color: #0a1128;
    font-size: 0.88rem;
  }

  .equipment-code {
    font-size: 0.75rem;
    color: #64748b;
  }

  :global(html.dark) .overview-card-head {
    border-color: #1e293b;
  }

  :global(html.dark) .equipment-row {
    background: #1e293b;
    border-color: #334155;
  }

  :global(html.dark) .equipment-name {
    color: #f8fafc;
  }

  :global(html.dark) .equipment-code {
    color: #94a3b8;
  }
</style>
