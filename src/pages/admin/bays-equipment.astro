---
import { requireRole } from '../../lib/auth';
import { getRuntimeEnv } from '../../lib/runtime-env';
import AdminLayout from '../../layouts/AdminLayout.astro';

const env = getRuntimeEnv(Astro.locals);
const auth = await requireRole(Astro.request, env, ['OWNER']);
if (!auth.ok) return auth.response;

let resources: any[] = [];
if (env?.DB) {
  try {
    const rows = await env.DB.prepare(`
      SELECT id, resource_code as resourceCode, resource_name as resourceName,
             resource_type as resourceType, supported_categories_json as supportedCategoriesJson,
             status, calibration_cert_no as calibrationCertNo, calibration_valid_until as calibrationValidUntil,
             notes, updated_at as updatedAt
      FROM station_resources
      ORDER BY resource_type ASC, resource_code ASC
    `).all<any>();
    resources = rows.results || [];
  } catch (e) {
    console.error('Failed to query station resources:', e);
  }
}
---

<AdminLayout title="Physical Bays & Hydro Rigs" owner={true} activeNav="bays">
  <div class="admin-app">
    <!-- Header -->
    <div class="admin-heading">
      <div>
        <p class="admin-eyebrow">STATION INFRASTRUCTURE & CALIBRATION</p>
        <h1>Physical Bays & Hydro Rigs</h1>
        <p class="admin-subtitle">
          Dynamic station resource management. Vehicle inspection bays, 300-bar hydrostatic water-jacket rigs, and statutory calibration logs.
        </p>
      </div>

      <div class="admin-actions">
        <button onclick="document.getElementById('modal-new-resource').style.display='flex'" class="admin-button">
          + Add Bay / Rig
        </button>
      </div>
    </div>

    <!-- Resource Cards Grid -->
    <div class="bays-grid">
      {resources.length === 0 ? (
        <div class="admin-card text-center">
          <p class="admin-empty">No station resources or bays configured yet.</p>
        </div>
      ) : (
        resources.map((res) => (
          <div class="admin-card bay-card">
            <div class="bay-card-top">
              <div class="bay-card-title-group">
                <span class="bay-type-tag">{res.resourceType}</span>
                <h3 class="bay-title">{res.resourceName}</h3>
                <code class="bay-code">Code: {res.resourceCode}</code>
              </div>

              <span class={`admin-status ${
                res.status === 'ONLINE' ? '' :
                res.status === 'OCCUPIED' ? 'pending' :
                res.status === 'MAINTENANCE' ? 'error' : 'pending'
              }`}>
                {res.status}
              </span>
            </div>

            <div class="bay-meta-box">
              <div class="bay-meta-row">
                <strong>Categories:</strong> <span>{res.supportedCategoriesJson || 'All standard CNG'}</span>
              </div>
              <div class="bay-meta-row">
                <strong>Calibration Cert:</strong> <span>{res.calibrationCertNo || 'Not recorded'}</span>
                {res.calibrationValidUntil && <span class="bay-valid-date"> (Valid: {res.calibrationValidUntil})</span>}
              </div>
            </div>

            <div class="bay-actions">
              <button onclick={`window.toggleStatus('${res.id}', 'ONLINE')`} class="admin-button secondary btn-sm btn-green">
                Set Online
              </button>
              <button onclick={`window.toggleStatus('${res.id}', 'MAINTENANCE')`} class="admin-button secondary btn-sm btn-red">
                Maintenance
              </button>
              <button onclick={`window.promptCalibration('${res.id}')`} class="admin-button secondary btn-sm btn-blue">
                Update Cert
              </button>
            </div>
          </div>
        ))
      )}
    </div>

    <!-- ADD RESOURCE MODAL -->
    <div id="modal-new-resource" class="mgmt-modal" style="display: none;">
      <div class="mgmt-modal-card">
        <div class="mgmt-modal-head">
          <h2 class="admin-section-title">Add Physical Bay or Rig</h2>
          <button type="button" class="mgmt-modal-close" onclick="document.getElementById('modal-new-resource').style.display='none'">✕</button>
        </div>
        <p class="admin-subtitle">
          Create an additional capacity resource for the testing facility.
        </p>

        <form id="form-add-resource" onsubmit="window.createResource(event)" class="admin-form">
          <label class="admin-field">
            Resource Code
            <input type="text" id="res-code" required placeholder="e.g. BAY_4 or RIG_C" class="admin-input uppercase-input" />
          </label>

          <label class="admin-field">
            Resource Name
            <input type="text" id="res-name" required placeholder="e.g. Commercial Bay 4 (Heavy)" class="admin-input" />
          </label>

          <label class="admin-field">
            Resource Type
            <select id="res-type" class="admin-select">
              <option value="VEHICLE_BAY">Vehicle Bay (Inspection & Intake)</option>
              <option value="HYDRO_RIG">Hydro Rig (300 Bar Water-Jacket)</option>
              <option value="INSPECTION_BENCH">Inspection Bench</option>
            </select>
          </label>

          <div class="modal-footer-actions">
            <button type="button" onclick="document.getElementById('modal-new-resource').style.display='none'" class="admin-button secondary">
              Cancel
            </button>
            <button type="submit" class="admin-button">
              Save Resource
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script is:inline>
    window.toggleStatus = async function (resourceId, newStatus) {
      if (!confirm(`Are you sure you want to change this resource status to ${newStatus}?`)) return;
      try {
        const res = await fetch('/api/admin/resources/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'TOGGLE_STATUS', resourceId, status: newStatus })
        });
        const data = await res.json();
        if (data.success) {
          window.location.reload();
        } else {
          alert(data.error?.message || 'Failed to update status');
        }
      } catch (e) {
        alert('Network error');
      }
    };

    window.promptCalibration = async function (resourceId) {
      const certNo = prompt('Enter NABL / PESO Calibration Certificate Number:');
      if (!certNo) return;
      const validUntil = prompt('Enter Validity End Date (YYYY-MM-DD):', '2027-12-31');
      if (!validUntil) return;

      try {
        const res = await fetch('/api/admin/resources/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'UPDATE_CALIBRATION', resourceId, calibrationCertNo: certNo, calibrationValidUntil: validUntil })
        });
        const data = await res.json();
        if (data.success) {
          window.location.reload();
        } else {
          alert(data.error?.message || 'Failed to update calibration');
        }
      } catch (e) {
        alert('Network error');
      }
    };

    window.createResource = async function (e) {
      e.preventDefault();
      const code = document.getElementById('res-code').value;
      const name = document.getElementById('res-name').value;
      const type = document.getElementById('res-type').value;

      try {
        const res = await fetch('/api/admin/resources/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'CREATE', resourceCode: code, resourceName: name, resourceType: type })
        });
        const data = await res.json();
        if (data.success) {
          window.location.reload();
        } else {
          alert(data.error?.message || 'Failed to create resource');
        }
      } catch (e) {
        alert('Network error');
      }
    };
  </script>
</AdminLayout>

<style>
  .bays-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.25rem;
  }

  .bay-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .bay-card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
  }

  .bay-type-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    font-weight: 700;
    color: #0284c7;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .bay-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1.15rem;
    font-weight: 800;
    color: #0a1128;
    margin: 0.2rem 0 0.15rem;
  }

  .bay-code {
    font-size: 0.78rem;
    color: #64748b;
  }

  .bay-meta-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 0.85rem;
    margin-bottom: 1.15rem;
    font-size: 0.82rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .bay-meta-row {
    color: #475569;
  }

  .bay-valid-date {
    color: #059669;
    font-weight: 600;
  }

  .bay-actions {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .btn-sm {
    padding: 0.35rem 0.65rem !important;
    font-size: 0.78rem !important;
  }

  .btn-green {
    color: #15803d !important;
  }

  .btn-red {
    color: #b91c1c !important;
  }

  .btn-blue {
    color: #0284c7 !important;
  }

  .uppercase-input {
    text-transform: uppercase;
  }

  .mgmt-modal {
    position: fixed;
    inset: 0;
    background: rgba(10, 17, 40, 0.65);
    backdrop-filter: blur(4px);
    z-index: 1000;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .mgmt-modal-card {
    background: #ffffff;
    border-radius: 14px;
    padding: 1.75rem;
    max-width: 480px;
    width: 100%;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.15);
    border: 1px solid #e2e8f0;
  }

  .mgmt-modal-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .mgmt-modal-close {
    background: transparent;
    border: none;
    font-size: 1.25rem;
    color: #64748b;
    cursor: pointer;
  }

  .modal-footer-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  :global(html.dark) .bay-title { color: #f8fafc; }
  :global(html.dark) .bay-meta-box { background: #1e293b; border-color: #334155; }
  :global(html.dark) .mgmt-modal-card { background: #131b2e; border-color: #1e293b; }
</style>
