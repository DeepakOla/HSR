---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentPage from '../../components/ContentPage.astro';
import { getDb, getBusinessSettings } from '../../lib/db';
import { getPageContent, getSeoMeta } from '../../lib/content';

const db = getDb(Astro);
const [settings, seo, page] = await Promise.all([
  getBusinessSettings(db),
  getSeoMeta(db, 'hi'),
  getPageContent(db, 'hi', 'contact'),
]);
---

<BaseLayout locale="hi" title={page.title} description={seo.description} canonicalPath="/hi/contact/" businessName={settings.business_name_hi}>
  <ContentPage title={page.title} body={page.body} locale="hi" contact={{ phone: settings.contact_phone, whatsappNumber: settings.whatsapp_number, email: settings.contact_email, address: settings.address_line, mapUrl: settings.map_url }} />
</BaseLayout>
