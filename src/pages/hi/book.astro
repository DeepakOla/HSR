---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookingWizard from '../../components/booking/BookingWizard';
import { getDb, getBusinessSettings } from '../../lib/db';
import { getSeoMeta } from '../../lib/content';

const db = getDb(Astro);
const [settings, seo] = await Promise.all([getBusinessSettings(db), getSeoMeta(db, 'hi')]);
---

<BaseLayout locale="hi" title="अपॉइंटमेंट बुक करें" description={seo.description} canonicalPath="/hi/book/" businessName={settings.business_name_hi}>
  <section class="section">
    <div class="container card">
      <h1>सीएनजी सिलेंडर हाइड्रो टेस्टिंग अपॉइंटमेंट बुक करें</h1>
      <BookingWizard client:load locale="hi" />
    </div>
  </section>
</BaseLayout>
