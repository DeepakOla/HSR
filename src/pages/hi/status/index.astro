---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getDb, getBusinessSettings } from '../../../lib/db';

const db = getDb(Astro);
const settings = await getBusinessSettings(db);
const booking = Astro.url.searchParams.get('booking') ?? '';
const token = Astro.url.searchParams.get('token') ?? '';
let data: any = null;
if (booking && token) {
  const url = new URL(`/api/status/${encodeURIComponent(booking)}?token=${encodeURIComponent(token)}`, Astro.url.origin);
  const res = await fetch(url, { headers: { cookie: Astro.request.headers.get('cookie') ?? '' } });
  if (res.ok) {
    const payload: any = await res.json();
    data = payload.data;
  }
}
---

<BaseLayout locale="hi" title="बुकिंग स्थिति" description="सुरक्षित बुकिंग स्थिति" canonicalPath="/hi/status/" businessName={settings.business_name_hi}>
  <section class="section">
    <div class="container card">
      <h1>बुकिंग स्थिति</h1>
      {data ? (
        <ul>
          <li>बुकिंग कोड: {data.bookingCode}</li>
          <li>बुकिंग स्थिति: {data.reservationState}</li>
          <li>भुगतान स्थिति: {data.paymentState}</li>
          <li>तारीख: {data.serviceDate}</li>
          <li>स्लॉट: {data.slotLabel}</li>
          <li>सिलेंडर: {data.cylinderCount}</li>
        </ul>
      ) : (
        <p>बुकिंग कन्फर्मेशन में मिले सुरक्षित लिंक का उपयोग करें।</p>
      )}
    </div>
  </section>
</BaseLayout>
