---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CustomerStatusView from '../../../components/status/CustomerStatusView';
import { getDb, getBusinessSettings } from '../../../lib/db';

const db = getDb(Astro);
const settings = await getBusinessSettings(db);
const booking = Astro.url.searchParams.get('booking') ?? '';
const token = Astro.url.searchParams.get('token') ?? '';
let data: any = null;
if (booking && token) {
  const url = new URL(`/api/status/${encodeURIComponent(booking)}?token=${encodeURIComponent(token)}`, Astro.url.origin);
  const res = await fetch(url, { headers: { cookie: Astro.request.headers.get('cookie') ?? '' } });
  if (res.ok) {
    const payload: any = await res.json();
    data = payload.data;
  }
}
const cityName = settings.city !== 'SETUP_REQUIRED' ? settings.city : 'रेवाड़ी';
---

<BaseLayout locale="hi" title="बुकिंग एवं सिलेंडर स्थिति" description="अपनी सीएनजी सिलेंडर टेस्टिंग अपॉइंटमेंट, परीक्षण प्रक्रिया और अनुपालन प्रमाणपत्र ट्रैक करें।" canonicalPath="/hi/status/" businessName={settings.business_name_hi} settings={settings}>
  <section class="section" style="padding-top: 1.5rem;">
    <CustomerStatusView
      client:load
      locale="hi"
      initialBooking={booking}
      initialToken={token}
      initialData={data}
      stationCity={cityName}
      stationPhone={settings.contact_phone}
      stationAddress={settings.address_line !== 'SETUP_REQUIRED' ? settings.address_line : 'एचएसआर ग्रीन एनर्जी, रेवाड़ी, हरियाणा'}
      stationMapUrl={settings.map_url !== 'SETUP_REQUIRED' ? settings.map_url : '#'}
    />
  </section>
</BaseLayout>
