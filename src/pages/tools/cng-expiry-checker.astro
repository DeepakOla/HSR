---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDb, getBusinessSettings } from '../../lib/db';

const db = getDb({ locals: Astro.locals } as any);
const settings = await getBusinessSettings(db);

const title = 'CNG Cylinder Retest Expiry Calculator & ₹200 Voucher | HSR Green Energy';
const description = 'Calculate statutory CNG cylinder hydro testing expiry under Gas Cylinders Rules (Rule 35). Claim ₹200 discount voucher on express bay retesting in Rewari.';
---

<BaseLayout
  locale="en"
  title={title}
  description={description}
  canonicalPath="/tools/cng-expiry-checker"
  businessName={settings.business_name_en}
  settings={settings}
>
  <main class="calc-page">
    <div class="calc-container">
      <div class="calc-header">
        <div class="calc-badge">STATUTORY RULE 35 COMPLIANCE</div>
        <h1 class="calc-title">CNG Cylinder Retest Due Date & Safety Calculator</h1>
        <p class="calc-subtitle">
          Under Indian Gas Cylinders Rules and MoRTH safety guidelines, all automotive CNG cylinders must undergo hydrostatic retesting every 3 years. Check your vehicle's compliance date and claim an instant <strong>₹200 discount voucher</strong> for HSR Rewari express testing bay.
        </p>
      </div>

      <div class="calc-grid">
        <!-- Input Form Card -->
        <div class="calc-card form-card">
          <h2 class="card-heading">Check Your Vehicle</h2>
          <form id="expiry-calc-form" class="calc-form">
            <div class="form-group">
              <label for="vehicleReg" class="form-label">Vehicle Registration Number</label>
              <input
                type="text"
                id="vehicleReg"
                name="vehicleReg"
                class="form-input text-uppercase font-mono"
                placeholder="e.g. HR36AB1234 or DL1CAA0001"
                required
              />
              <span class="field-hint">Any Indian RTO registration</span>
            </div>

            <div class="form-group">
              <label for="mobile" class="form-label">Mobile Number (For WhatsApp Voucher)</label>
              <input
                type="tel"
                id="mobile"
                name="mobile"
                class="form-input font-mono"
                placeholder="e.g. 9876543210"
                pattern="[0-9]{10}"
                required
              />
              <span class="field-hint">Voucher code & test report reminder will be sent here</span>
            </div>

            <div class="form-group">
              <label for="lastTestDate" class="form-label">Date of Last Hydro Test (or CNG Fitment)</label>
              <input
                type="date"
                id="lastTestDate"
                name="lastTestDate"
                class="form-input"
                required
              />
              <span class="field-hint">Found stamped on brass plate near cylinder valve</span>
            </div>

            <div class="form-group">
              <label for="vehicleCategory" class="form-label">Vehicle Type</label>
              <select id="vehicleCategory" name="vehicleCategory" class="form-select">
                <option value="CAR">Personal / Taxi Car (1-2 Cylinders)</option>
                <option value="TEMPO_LCV">Commercial Tempo / LCV (2-4 Cylinders)</option>
                <option value="TRUCK_BUS">Heavy Truck / Bus (4-12+ Cylinders)</option>
              </select>
            </div>

            <button type="submit" id="btn-calc-submit" class="btn-submit">
              <span>Calculate Expiry & Get ₹200 Voucher</span>
              <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18">
                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </button>
          </form>
        </div>

        <!-- Result Dynamic Panel -->
        <div class="calc-card result-card" id="result-placeholder">
          <div class="placeholder-content">
            <div class="icon-circle">
              <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.75">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                <line x1="16" y1="2" x2="16" y2="6"/>
                <line x1="8" y1="2" x2="8" y2="6"/>
                <line x1="3" y1="10" x2="21" y2="10"/>
              </svg>
            </div>
            <h3>Enter Vehicle Details</h3>
            <p>Your calculated statutory expiry date, compliance certificate status, and ₹200 launch coupon code will appear here instantly.</p>
          </div>
        </div>

        <!-- Active Result Card (Hidden Initially) -->
        <div class="calc-card result-card active-result" id="result-active" style="display: none;">
          <div class="result-badge-row">
            <span id="res-status-badge" class="badge-status">VALID</span>
            <span class="badge-corridor">Rewari Express Bay</span>
          </div>

          <div class="due-display">
            <div class="due-label">Statutory Retest Due Date:</div>
            <div class="due-date" id="res-due-date">15 Nov 2029</div>
            <div class="due-countdown" id="res-countdown">1,095 days remaining</div>
          </div>

          <!-- Voucher Box -->
          <div class="voucher-box">
            <div class="voucher-tag">SPECIAL LAUNCH OFFER</div>
            <div class="voucher-code-row">
              <span class="voucher-code" id="res-voucher-code">HSR200-ABCD</span>
              <button type="button" id="btn-copy-voucher" class="btn-copy">Copy</button>
            </div>
            <p class="voucher-desc">Flat ₹200 discount applicable on online booking or at HSR testing counter.</p>
          </div>

          <!-- WhatsApp Action Button -->
          <a id="res-wa-link" href="#" target="_blank" rel="noopener noreferrer" class="btn-claim-wa">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.074-2.125-.519-1.829-.757-3.003-2.618-3.094-2.739-.091-.121-.741-.987-.741-1.884 0-.897.469-1.339.635-1.522.166-.182.363-.228.485-.228.121 0 .242.002.348.006.111.005.26-.042.406.312.152.368.515 1.258.56 1.349.045.091.076.197.015.318-.06.121-.091.197-.181.303-.091.106-.191.237-.273.318-.091.091-.186.19-.08.373.106.182.471.777 1.01 1.258.694.619 1.28.811 1.462.902.182.091.288.076.394-.045.106-.121.454-.53.576-.712.121-.182.242-.152.406-.091.166.061 1.054.497 1.235.588.182.091.303.136.348.212.045.076.045.439-.099.844z"/>
            </svg>
            <span>Book Express Bay on WhatsApp</span>
          </a>

          <div class="compliance-note">
            Testing performed at HSR Green Energy, Rewari with PESO-certified water jacket hydrostatic testing at 300 Bar pressure.
          </div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .calc-page {
    background: #f8fafc;
    padding: 3rem 1rem 5rem;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
  }

  .calc-container {
    max-width: 1040px;
    margin: 0 auto;
  }

  .calc-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 2.5rem;
  }

  .calc-badge {
    display: inline-block;
    background: rgba(234, 88, 12, 0.1);
    color: #ea580c;
    font-weight: 800;
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    margin-bottom: 0.75rem;
    text-transform: uppercase;
  }

  .calc-title {
    font-size: 2.1rem;
    font-weight: 800;
    color: #0a1128;
    line-height: 1.25;
    margin: 0 0 1rem;
  }

  .calc-subtitle {
    font-size: 0.98rem;
    color: #475569;
    line-height: 1.6;
    margin: 0;
  }

  .calc-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 2rem;
    align-items: start;
  }

  .calc-card {
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid #e2e8f0;
    padding: 2rem;
    box-shadow: 0 4px 18px rgba(10, 17, 40, 0.04);
  }

  .card-heading {
    font-size: 1.25rem;
    font-weight: 700;
    color: #0a1128;
    margin: 0 0 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #f1f5f9;
  }

  .calc-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-label {
    font-size: 0.84rem;
    font-weight: 600;
    color: #1e293b;
  }

  .form-input, .form-select {
    padding: 0.75rem 1rem;
    font-size: 0.95rem;
    border: 1.5px solid #cbd5e1;
    border-radius: 8px;
    color: #0f172a;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .form-input:focus, .form-select:focus {
    border-color: #0284c7;
    outline: none;
    box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
  }

  .field-hint {
    font-size: 0.74rem;
    color: #64748b;
  }

  .btn-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: #ea580c;
    color: #ffffff;
    font-weight: 700;
    font-size: 1rem;
    padding: 0.9rem 1.5rem;
    border-radius: 10px;
    border: none;
    cursor: pointer;
    transition: background 0.18s, transform 0.1s;
    margin-top: 0.5rem;
  }

  .btn-submit:hover {
    background: #c2410c;
    transform: translateY(-1px);
  }

  .placeholder-content {
    text-align: center;
    padding: 3rem 1rem;
    color: #64748b;
  }

  .icon-circle {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #f1f5f9;
    color: #0284c7;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.25rem;
  }

  .placeholder-content h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: #0a1128;
    margin: 0 0 0.5rem;
  }

  .placeholder-content p {
    font-size: 0.86rem;
    line-height: 1.5;
    margin: 0;
  }

  .result-badge-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .badge-status {
    background: #dcfce7;
    color: #15803d;
    font-weight: 800;
    font-size: 0.74rem;
    letter-spacing: 0.05em;
    padding: 0.3rem 0.75rem;
    border-radius: 6px;
  }

  .badge-status.overdue {
    background: #fee2e2;
    color: #b91c1c;
  }

  .badge-corridor {
    font-size: 0.78rem;
    color: #64748b;
    font-weight: 600;
  }

  .due-display {
    text-align: center;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .due-label {
    font-size: 0.8rem;
    color: #64748b;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .due-date {
    font-size: 1.75rem;
    font-weight: 800;
    color: #0a1128;
    margin: 0.35rem 0;
  }

  .due-countdown {
    font-size: 0.86rem;
    font-weight: 600;
    color: #ea580c;
  }

  .voucher-box {
    background: linear-gradient(135deg, #0a1128, #1e293b);
    color: #ffffff;
    border-radius: 12px;
    padding: 1.25rem;
    text-align: center;
    margin-bottom: 1.5rem;
    position: relative;
    overflow: hidden;
  }

  .voucher-tag {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: #fdba74;
    margin-bottom: 0.5rem;
  }

  .voucher-code-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .voucher-code {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.4rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: 0.08em;
    background: rgba(255, 255, 255, 0.12);
    padding: 0.25rem 0.85rem;
    border-radius: 6px;
    border: 1px dashed rgba(255, 255, 255, 0.4);
  }

  .btn-copy {
    background: #ea580c;
    color: #ffffff;
    border: none;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.4rem 0.75rem;
    border-radius: 6px;
    cursor: pointer;
  }

  .voucher-desc {
    font-size: 0.78rem;
    color: #cbd5e1;
    margin: 0;
  }

  .btn-claim-wa {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: #25d366;
    color: #ffffff;
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.85rem 1.25rem;
    border-radius: 10px;
    text-decoration: none;
    margin-bottom: 1rem;
    transition: background 0.15s;
  }

  .btn-claim-wa:hover {
    background: #20ba5a;
  }

  .compliance-note {
    font-size: 0.72rem;
    color: #64748b;
    line-height: 1.4;
    text-align: center;
  }

  @media (max-width: 860px) {
    .calc-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById('expiry-calc-form') as HTMLFormElement;
  const resultPlaceholder = document.getElementById('result-placeholder');
  const resultActive = document.getElementById('result-active');
  const btnSubmit = document.getElementById('btn-calc-submit') as HTMLButtonElement;

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      btnSubmit.disabled = true;
      btnSubmit.textContent = 'Calculating...';

      const formData = new FormData(form);
      const payload = {
        vehicleReg: formData.get('vehicleReg'),
        mobile: formData.get('mobile'),
        lastTestDate: formData.get('lastTestDate'),
        vehicleCategory: formData.get('vehicleCategory'),
        corridor: 'Gurugram-Rewari'
      };

      try {
        const res = await fetch('/api/public/expiry-calculator', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data: any = await res.json();
        if (!res.ok) throw new Error(data.error?.message || 'Calculation error');

        const { calculatedExpiryDate, daysUntilExpiry, isOverdue, voucherCode, whatsappBookLink } = data.data;

        // Populate Result
        const resDueDate = document.getElementById('res-due-date');
        const resCountdown = document.getElementById('res-countdown');
        const resVoucherCode = document.getElementById('res-voucher-code');
        const resStatusBadge = document.getElementById('res-status-badge');
        const resWaLink = document.getElementById('res-wa-link') as HTMLAnchorElement;

        if (resDueDate) resDueDate.textContent = calculatedExpiryDate;
        if (resCountdown) {
          if (isOverdue) {
            resCountdown.textContent = `OVERDUE by ${Math.abs(daysUntilExpiry)} days (Unsafe for Refueling)`;
            resCountdown.style.color = '#dc2626';
          } else {
            resCountdown.textContent = `${daysUntilExpiry} days remaining until statutory deadline`;
            resCountdown.style.color = '#15803d';
          }
        }

        if (resStatusBadge) {
          if (isOverdue) {
            resStatusBadge.textContent = 'RETEST OVERDUE';
            resStatusBadge.className = 'badge-status overdue';
          } else {
            resStatusBadge.textContent = 'VALID COMPLIANCE';
            resStatusBadge.className = 'badge-status';
          }
        }

        if (resVoucherCode) resVoucherCode.textContent = voucherCode;
        if (resWaLink) resWaLink.href = whatsappBookLink;

        // Switch cards
        if (resultPlaceholder) resultPlaceholder.style.display = 'none';
        if (resultActive) resultActive.style.display = 'block';

      } catch (err: any) {
        alert(err.message || 'Failed to calculate expiry');
      } finally {
        btnSubmit.disabled = false;
        btnSubmit.textContent = 'Calculate Expiry & Get ₹200 Voucher';
      }
    });

    const copyBtn = document.getElementById('btn-copy-voucher');
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const code = document.getElementById('res-voucher-code')?.textContent || '';
        navigator.clipboard.writeText(code).then(() => {
          copyBtn.textContent = 'Copied!';
          setTimeout(() => { copyBtn.textContent = 'Copy'; }, 1800);
        });
      });
    }
  }
</script>
