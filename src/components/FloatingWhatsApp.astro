---
interface Props {
  whatsappNumber?: string;
  contactPhone?: string;
  businessName?: string;
  showFloating?: number | boolean;
}

const {
  whatsappNumber = '+919910055355',
  contactPhone = '+919910055355',
  businessName = 'HSR Green Energy',
  showFloating = 1
} = Astro.props;

if (!showFloating || showFloating === 0) {
  // Do not render if disabled by owner in settings
  return null;
}

const cleanWa = whatsappNumber.replace(/[^0-9]/g, '');
const cleanPhone = contactPhone.replace(/[^0-9+]/g, '');
const waText = encodeURIComponent(`Hello ${businessName}, I would like to inquire about CNG cylinder hydro testing.`);
const waUrl = `https://wa.me/${cleanWa}?text=${waText}`;
const telUrl = `tel:${cleanPhone}`;
---

<div class="hsr-floating-contact" id="hsr-floating-contact" aria-label="Quick Contact & Support">
  <!-- Expanded popover menu -->
  <div class="contact-popover" id="contact-popover">
    <div class="popover-header">
      <div class="online-indicator"></div>
      <div>
        <div class="popover-title">HSR Support Desk</div>
        <div class="popover-subtitle">Rewari Express Testing Bay</div>
      </div>
    </div>
    <div class="popover-body">
      <a href={waUrl} target="_blank" rel="noopener noreferrer" class="popover-btn btn-wa">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.074-2.125-.519-1.829-.757-3.003-2.618-3.094-2.739-.091-.121-.741-.987-.741-1.884 0-.897.469-1.339.635-1.522.166-.182.363-.228.485-.228.121 0 .242.002.348.006.111.005.26-.042.406.312.152.368.515 1.258.56 1.349.045.091.076.197.015.318-.06.121-.091.197-.181.303-.091.106-.191.237-.273.318-.091.091-.186.19-.08.373.106.182.471.777 1.01 1.258.694.619 1.28.811 1.462.902.182.091.288.076.394-.045.106-.121.454-.53.576-.712.121-.182.242-.152.406-.091.166.061 1.054.497 1.235.588.182.091.303.136.348.212.045.076.045.439-.099.844z"/>
        </svg>
        <span>Chat on WhatsApp</span>
      </a>
      <a href={telUrl} class="popover-btn btn-call">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        <span>Call Express Bay</span>
      </a>
    </div>
  </div>

  <!-- Primary Floating Toggle Button -->
  <button
    type="button"
    class="floating-btn"
    id="floating-toggle-btn"
    aria-label="Toggle contact menu"
    aria-expanded="false"
  >
    <span class="btn-icon icon-wa">
      <svg viewBox="0 0 24 24" width="30" height="30" fill="currentColor">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.074-2.125-.519-1.829-.757-3.003-2.618-3.094-2.739-.091-.121-.741-.987-.741-1.884 0-.897.469-1.339.635-1.522.166-.182.363-.228.485-.228.121 0 .242.002.348.006.111.005.26-.042.406.312.152.368.515 1.258.56 1.349.045.091.076.197.015.318-.06.121-.091.197-.181.303-.091.106-.191.237-.273.318-.091.091-.186.19-.08.373.106.182.471.777 1.01 1.258.694.619 1.28.811 1.462.902.182.091.288.076.394-.045.106-.121.454-.53.576-.712.121-.182.242-.152.406-.091.166.061 1.054.497 1.235.588.182.091.303.136.348.212.045.076.045.439-.099.844z"/>
      </svg>
    </span>
    <span class="btn-icon icon-close">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </span>
    <span class="pulse-ring"></span>
  </button>
</div>

<style>
  .hsr-floating-contact {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 9999;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
  }

  .floating-btn {
    position: relative;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #25d366;
    color: #ffffff;
    border: none;
    box-shadow: 0 4px 16px rgba(37, 211, 102, 0.4), 0 2px 6px rgba(0, 0, 0, 0.15);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.2s;
    outline: none;
  }

  .floating-btn:hover {
    transform: scale(1.08);
    background: #20ba5a;
  }

  .floating-btn:active {
    transform: scale(0.96);
  }

  .btn-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s, transform 0.2s;
  }

  .icon-close {
    display: none;
  }

  .hsr-floating-contact.open .icon-wa {
    display: none;
  }

  .hsr-floating-contact.open .icon-close {
    display: flex;
  }

  .hsr-floating-contact.open .floating-btn {
    background: #0a1128;
  }

  .pulse-ring {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 2px solid #25d366;
    animation: pulse 2.2s infinite cubic-bezier(0.25, 1, 0.5, 1);
    pointer-events: none;
  }

  .hsr-floating-contact.open .pulse-ring {
    display: none;
  }

  @keyframes pulse {
    0% { transform: scale(1); opacity: 0.8; }
    100% { transform: scale(1.6); opacity: 0; }
  }

  .contact-popover {
    position: absolute;
    bottom: 74px;
    right: 0;
    width: 260px;
    background: #ffffff;
    border-radius: 14px;
    box-shadow: 0 10px 30px rgba(10, 17, 40, 0.18), 0 2px 8px rgba(0, 0, 0, 0.08);
    border: 1px solid #e2e8f0;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px) scale(0.95);
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1), transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.2s;
  }

  .hsr-floating-contact.open .contact-popover {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  .popover-header {
    background: #0a1128;
    color: #ffffff;
    padding: 12px 14px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .online-indicator {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 6px #22c55e;
  }

  .popover-title {
    font-size: 0.88rem;
    font-weight: 700;
  }

  .popover-subtitle {
    font-size: 0.72rem;
    color: #94a3b8;
  }

  .popover-body {
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .popover-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 8px;
    text-decoration: none;
    font-size: 0.84rem;
    font-weight: 600;
    transition: background 0.15s, transform 0.1s;
  }

  .btn-wa {
    background: #f0fdf4;
    color: #15803d;
    border: 1px solid #bbf7d0;
  }

  .btn-wa:hover {
    background: #25d366;
    color: #ffffff;
    border-color: #25d366;
  }

  .btn-call {
    background: #f8fafc;
    color: #0a1128;
    border: 1px solid #e2e8f0;
  }

  .btn-call:hover {
    background: #ea580c;
    color: #ffffff;
    border-color: #ea580c;
  }

  @media (max-width: 640px) {
    .hsr-floating-contact {
      bottom: 20px;
      right: 18px;
    }
    .floating-btn {
      width: 54px;
      height: 54px;
    }
  }
</style>

<script>
  function initFloatingContact() {
    const container = document.getElementById('hsr-floating-contact');
    const toggleBtn = document.getElementById('floating-toggle-btn');
    if (!container || !toggleBtn) return;

    toggleBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = container.classList.toggle('open');
      toggleBtn.setAttribute('aria-expanded', String(isOpen));
    });

    document.addEventListener('click', (e) => {
      if (!container.contains(e.target as Node)) {
        container.classList.remove('open');
        toggleBtn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFloatingContact);
  } else {
    initFloatingContact();
  }
</script>
