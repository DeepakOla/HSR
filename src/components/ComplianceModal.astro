---
import type { Locale } from '../lib/constants';

interface Props {
  locale: Locale;
  bookUrl?: string;
}

const { locale, bookUrl = `/${locale}/book/` } = Astro.props;
const hindi = locale === 'hi';
---

<div id="compliance-alert-modal" class="compliance-modal-backdrop" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="compliance-modal-title">
  <div class="compliance-modal-card">
    <div class="modal-accent-bar"></div>
    <div class="modal-content-container">
      <div class="modal-header">
        <div>
          <div class="modal-statutory-chip">
            <span>⚠️</span>
            <span>{hindi ? 'वैधानिक चेतावनी • गैस सिलेंडर नियम 2016' : 'Statutory Alert • Gas Cylinders Rules 2016'}</span>
          </div>
          <h2 id="compliance-modal-title" class="modal-headline">
            {hindi ? 'हाइड्रो टेस्ट देय — नियम 35 नोटिस' : 'Hydro Test Overdue — Rule 35 Notice'}
          </h2>
        </div>
        <button type="button" class="modal-close-trigger" id="close-compliance-modal-x" aria-label={hindi ? 'बंद करें' : 'Close Notice'}>
          ✕
        </button>
      </div>

      <div class="modal-status-pills">
        <span class="pill-danger">
          <span class="danger-dot"></span>
          {hindi ? 'रिफ्यूलिंग इंकार का उच्च जोखिम' : 'Refusal Risk: High'}
        </span>
        <span class="pill-warning">
          {hindi ? 'तत्काल परीक्षण अनिवार्य' : 'Immediate Testing Required'}
        </span>
      </div>

      <div class="modal-specs-box">
        <div class="spec-row">
          <span class="spec-label">{hindi ? 'वैधानिक नियम' : 'Statutory Requirement'}</span>
          <span class="spec-value font-mono-num font-bold">Rule 35, Gas Cylinders Rules 2016</span>
        </div>
        <div class="spec-row">
          <span class="spec-label">{hindi ? 'परीक्षण चक्र' : 'Testing Cycle'}</span>
          <span class="spec-value">{hindi ? 'प्रत्येक 36 माह (3 वर्ष) में अनिवार्य' : 'Mandatory Every 36 Months (3 Years)'}</span>
        </div>
        <div class="spec-row">
          <span class="spec-label">{hindi ? 'सीएनजी स्टेशन नियम' : 'CGD Station Action'}</span>
          <span class="spec-value text-danger font-bold">{hindi ? 'गैस रिफिलिंग इंकार (IGL, HCG, Adani, आदि)' : 'Blacklisted / Refusal Enforced (IGL, HCG, Adani)'}</span>
        </div>
        <div class="spec-row">
          <span class="spec-label">{hindi ? 'कानूनी प्रावधान' : 'Legal Penalty'}</span>
          <span class="spec-value text-warning font-bold">{hindi ? 'मोटर वाहन अधिनियम 190(2) के तहत ₹10,000 जुर्माना' : '₹10,000 Fine under MVA Sec 190(2)'}</span>
        </div>
      </div>

      <div class="modal-notice-advisory">
        <span class="advisory-icon">⚖️</span>
        <p>
          <strong>{hindi ? 'वैधानिक सलाह:' : 'Statutory Advisory:'}</strong>{' '}
          {hindi
            ? 'सीएनजी फिलर वाल्व के पास बिना वैध पीतल अनुपालन प्लेट के वाहन चलाना सुरक्षा मानकों का उल्लंघन है। सभी गैस स्टेशनों को नोज़ल लॉक से पहले प्लेट की जांच करने का कानूनी निर्देश है।'
            : 'Operating without an authorized PESO compliance plate near the CNG filling valve violates central safety norms. All CGD fuel pump operators are legally mandated to verify expiry before dispenser nozzle lock.'}
        </p>
      </div>

      <div class="modal-footer-actions">
        <a href={bookUrl} class="btn btn-primary modal-action-cta">
          ⚡ {hindi ? 'इंकार से बचें: एक्सप्रेस स्लॉट बुक करें' : 'Avoid Pump Refusal: Book Express Bay Testing'}
        </a>
        <button type="button" class="btn btn-secondary modal-cancel-btn" id="close-compliance-modal-btn">
          {hindi ? 'बंद करें' : 'Close'}
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .compliance-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(10, 17, 40, 0.75);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    animation: fadeIn 0.2s ease-out;
  }

  .compliance-modal-card {
    background: #ffffff;
    border-radius: 20px;
    max-width: 580px;
    width: 100%;
    border: 1px solid #cbd5e1;
    box-shadow: 0 25px 50px -12px rgba(10, 17, 40, 0.25);
    overflow: hidden;
    position: relative;
    animation: zoomIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .modal-accent-bar {
    height: 6px;
    background: linear-gradient(90deg, #ea580c 0%, #f59e0b 50%, #0284c7 100%);
  }

  .modal-content-container {
    padding: 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .modal-statutory-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    background: #fffbeb;
    border: 1px solid #fde68a;
    color: #b45309;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.4rem;
  }

  .modal-headline {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 1.4rem;
    font-weight: 800;
    color: #0a1128;
    margin: 0;
    line-height: 1.25;
  }

  .modal-close-trigger {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    color: #475569;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s ease;
    flex-shrink: 0;
  }

  .modal-close-trigger:hover {
    background: #e2e8f0;
    color: #0a1128;
  }

  .modal-status-pills {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .pill-danger {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #b91c1c;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .danger-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #dc2626;
    animation: pulse 1.5s infinite;
  }

  .pill-warning {
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    background: #fffbeb;
    border: 1px solid #fde68a;
    color: #b45309;
    font-size: 0.78rem;
    font-weight: 600;
  }

  .modal-specs-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 0.85rem 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .spec-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #e2e8f0;
    font-size: 0.84rem;
    gap: 0.5rem;
  }

  .spec-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .spec-label {
    color: #64748b;
    font-weight: 500;
  }

  .spec-value {
    color: #0f172a;
    text-align: right;
  }

  .text-danger {
    color: #dc2626 !important;
  }

  .text-warning {
    color: #d97706 !important;
  }

  .modal-notice-advisory {
    background: #fefce8;
    border: 1px solid #fef08a;
    border-radius: 10px;
    padding: 0.75rem 1rem;
    display: flex;
    gap: 0.65rem;
    font-size: 0.78rem;
    color: #713f12;
    line-height: 1.45;
  }

  .advisory-icon {
    font-size: 1.1rem;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .modal-footer-actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }

  .modal-action-cta {
    flex: 1;
    min-width: 220px;
    justify-content: center;
    font-weight: 700;
    text-align: center;
    padding: 0.75rem 1rem;
  }

  .modal-cancel-btn {
    padding: 0.75rem 1.25rem;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes zoomIn {
    from { transform: scale(0.95); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.9); }
  }
</style>

<script>
  function setupComplianceModal() {
    const modal = document.getElementById('compliance-alert-modal');
    const closeX = document.getElementById('close-compliance-modal-x');
    const closeBtn = document.getElementById('close-compliance-modal-btn');
    const openBtns = document.querySelectorAll('[data-open-compliance-modal], #open-compliance-notice-btn');

    const openModal = () => {
      if (modal) modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    };

    const closeModal = () => {
      if (modal) modal.style.display = 'none';
      document.body.style.overflow = '';
    };

    openBtns.forEach((btn) => btn.addEventListener('click', openModal));
    if (closeX) closeX.addEventListener('click', closeModal);
    if (closeBtn) closeBtn.addEventListener('click', closeModal);

    // Backdrop click
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
    }

    // Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && modal.style.display !== 'none') {
        closeModal();
      }
    });

    // Expose global helper for other components
    (window as any).openComplianceModal = openModal;
  }

  // Run on page load
  setupComplianceModal();
  document.addEventListener('astro:page-load', setupComplianceModal);
</script>
