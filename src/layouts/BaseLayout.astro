---
import type { Locale } from '../lib/constants';
import type { BusinessSettings } from '../lib/types';
import { localizePath, otherLocale, t } from '../lib/i18n';
import { buildLocalBusinessSchema } from '../lib/seo';
import FeedbackModal from '../components/FeedbackModal';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import '../styles/design-tokens.css';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  canonicalPath: string;
  businessName: string;
  settings?: BusinessSettings;
}

const { locale, title, description, canonicalPath, businessName, settings } = Astro.props;
const copy = t(locale);
const alternate = otherLocale(locale);
const path = canonicalPath.endsWith('/') ? canonicalPath : `${canonicalPath}/`;
const canonical = new URL(path, Astro.url.origin);
const alternateHref = new URL(localizePath(path, alternate), Astro.url.origin);

const currentPath = Astro.url.pathname;
const isHome = currentPath === `/${locale}/` || currentPath === `/${locale}`;
const getAnchor = (id: string) => isHome ? `#${id}` : `/${locale}/#${id}`;

const effectiveSettings = settings ?? ({
  business_name_en: businessName || 'HSR Green Energy',
  business_name_hi: businessName || 'एचएसआर ग्रीन एनर्जी',
  city: 'Rewari',
  address_line: 'Rewari Industrial Corridor (NH-48), Rewari, Haryana 123401',
  contact_phone: '+919910055355',
  whatsapp_number: '+919910055355',
  contact_email: 'contact@hsrgreenenergy.com',
  map_url: 'https://maps.google.com/?q=Rewari+Haryana+CNG+Hydro+Testing',
  seo_title_en: title,
  seo_title_hi: title,
  seo_desc_en: description,
  seo_desc_hi: description,
} as any);

const schema = buildLocalBusinessSchema({
  settings: effectiveSettings,
  locale,
  currentUrl: canonical.toString(),
});

const customPromoBanner = (effectiveSettings.promo_banner_active !== 0 && effectiveSettings.promo_banner_text)
  ? effectiveSettings.promo_banner_text
  : null;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/jpeg" href={effectiveSettings.brand_logo_url || '/images/hsr-gauge-logo.jpg'} />
    <link rel="canonical" href={canonical.toString()} />
    <link rel="alternate" hreflang={alternate} href={alternateHref.toString()} />
    <link rel="alternate" hreflang={locale} href={canonical.toString()} />

    <!-- High-Performance Web Fonts (Route-Specific Subsetting: Latin only on English, Devanagari on Hindi) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://images.unsplash.com" />
    {locale === 'hi' ? (
      <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+Devanagari:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
    ) : (
      <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
    )}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={locale === 'hi' ? 'hi_IN' : 'en_IN'} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical.toString()} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <!-- Clean Static Top Announcement Bar (0 Main Thread Animation Overhead) -->
    <aside class="announcement-ticker-bar demo-banner" role="status" aria-label={locale === 'en' ? 'Station Announcements' : 'स्टेशन सूचना'}>
      <div class="ticker-track-container">
        <div class="ticker-track">
          {customPromoBanner && (
            <span class="ticker-item ticker-promo-item">
              <span class="ticker-badge promo-tag">🎉 {locale === 'en' ? 'SPECIAL OFFER' : 'विशेष ऑफ़र'}</span>
              <strong class="promo-text">{customPromoBanner}</strong>
            </span>
          )}
          <span class="ticker-item">
            <span class="ticker-badge demo-tag">⚡ {locale === 'en' ? 'GOVERNMENT APPROVED' : 'सरकारी प्रमाणित'}</span>
            <span class="demo-text">{locale === 'en' ? 'Government Approved Testing Facility (PESO Certified) — Rewari, Haryana' : 'सरकारी प्रमाणित टेस्टिंग सुविधा (PESO Certified) — रेवाड़ी, हरियाणा'}</span>
          </span>
          <span class="ticker-item">
            <span class="ticker-badge">⏱️ {locale === 'en' ? 'FAST' : 'त्वरित'}</span>
            <span>{locale === 'en' ? '2 to 3 Hour Express Turnaround | Avoid Fuel Pump Refusal' : '2 से 3 घंटे में एक्सप्रेस टेस्टिंग | पंप पर गैस रिफिलिंग इंकार से बचें'}</span>
          </span>
          <span class="ticker-item">
            <span class="ticker-badge">🛡️ {locale === 'en' ? 'COMPLIANCE' : 'अनुपालन'}</span>
            <span>{locale === 'en' ? '300 Bar Water Jacket Test | Stamped Brass Compliance Plate & Certificate' : 'प्रमाणित 300 बार वाटर जैकेट टेस्ट | मोहरबंद पीतल प्लेट एवं प्रमाणपत्र'}</span>
          </span>
        </div>
      </div>
      <div class="ticker-feedback-dock">
        <button type="button" class="ticker-feedback-btn" id="open-feedback-btn">
          💬 {locale === 'en' ? 'Feedback' : 'प्रतिक्रिया'}
        </button>
      </div>
    </aside>

    <header class="app-header">
      <div class="container topbar">
        <a href={`/${locale}/`} class="brand-link">
          <img src={effectiveSettings.brand_logo_url || '/images/hsr-gauge-logo.jpg'} alt={businessName || 'HSR CNG'} class="brand-logo-img" />
          <div class="brand-text-col">
            <span class="brand-logo-text">{businessName || 'HSR'}</span>
            <span class="brand-subtext">{locale === 'en' ? 'CNG Hydro Testing' : 'सीएनजी हाइड्रो टेस्टिंग'}</span>
          </div>
        </a>

        <!-- Desktop Navigation: Services, Book, Blog, Contact, Login -->
        <nav aria-label={locale === 'en' ? 'Primary navigation' : 'मुख्य नेविगेशन'} class="primary-nav">
          <ul class="nav-list">
            <li><a href={`/${locale}/services/`}>{locale === 'en' ? 'Services' : 'सेवाएँ'}</a></li>
            <li><a href={`/${locale}/book/`}>{locale === 'en' ? 'Book' : 'बुक करें'}</a></li>
            <li><a href={`/${locale}/blog/`}>{locale === 'en' ? 'Blog' : 'ब्लॉग'}</a></li>
            <li><a href={`/${locale}/contact/`}>{locale === 'en' ? 'Contact' : 'संपर्क'}</a></li>
            <li>
              <a href="/admin/login/" class="nav-login-btn" style="color: var(--color-steel-600); font-weight: 700;">
                🔐 {locale === 'en' ? 'Login' : 'लॉगिन'}
              </a>
            </li>
          </ul>
        </nav>

        <div class="header-actions">
          <a class="lang-pill" href={localizePath(Astro.url.pathname, alternate)} aria-label="Change language">
            {alternate === 'hi' ? 'हिंदी' : 'English'}
          </a>
          <a href={`/${locale}/book/`} class="btn btn-primary nav-book-btn">
            {copy.actions.book}
          </a>
        </div>

        <!-- Mobile Navigation Toggle -->
        <button
          type="button"
          class="mobile-nav-toggle"
          id="mobile-nav-toggle"
          aria-expanded="false"
          aria-controls="mobile-nav-drawer"
          aria-label={locale === 'en' ? 'Toggle navigation menu' : 'नेविगेशन मेनू खोलें/बंद करें'}
        >
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
        </button>
      </div>

      <!-- Mobile Navigation Drawer Overlay -->
      <div class="mobile-nav-drawer" id="mobile-nav-drawer" hidden>
        <div class="mobile-nav-backdrop" id="mobile-nav-backdrop"></div>
        <div class="mobile-nav-panel">
          <div class="mobile-nav-header">
            <div>
              <strong class="mobile-brand-title">{businessName || 'HSR'}</strong>
              <span class="mobile-brand-sub">{locale === 'en' ? 'Rewari Station' : 'रेवाड़ी केंद्र'}</span>
            </div>
            <button type="button" class="mobile-nav-close" id="mobile-nav-close" aria-label="Close navigation">✕</button>
          </div>

          <nav aria-label={locale === 'en' ? 'Mobile navigation' : 'मोबाइल नेविगेशन'} class="mobile-nav-links">
            <a href={`/${locale}/book/`} class="mobile-nav-item mobile-book-cta">
              ⚡ {locale === 'en' ? 'Book Testing Bay' : 'स्लॉट बुक करें'}
            </a>
            <a href={`/${locale}/services/`} class="mobile-nav-item">
              🔬 {locale === 'en' ? 'Our Services' : 'हमारी सेवाएँ'}
            </a>
            <a href={`/${locale}/blog/`} class="mobile-nav-item">
              📖 {locale === 'en' ? 'Blog & Advice' : 'ब्लॉग व सलाह'}
            </a>
            <a href={`/${locale}/contact/`} class="mobile-nav-item">
              📍 {locale === 'en' ? 'Contact & Facility' : 'संपर्क व केंद्र'}
            </a>
            <a href="/admin/login/" class="mobile-nav-item" style="border-top: 1px solid var(--border-subtle); margin-top: 0.5rem; padding-top: 1rem; color: var(--color-steel-600); font-weight: 700;">
              🔐 {locale === 'en' ? 'Login Portal (Staff / Admin / Customer)' : 'लॉगिन पोर्टल (कर्मचारी / एडमिन / ग्राहक)'}
            </a>
          </nav>

          <div class="mobile-nav-footer">
            <a class="lang-pill mobile-lang-pill" href={localizePath(Astro.url.pathname, alternate)}>
              🌐 {alternate === 'hi' ? 'हिंदी में बदलें' : 'Switch to English'}
            </a>
            <a href="/admin/login/" class="staff-login-link mobile-staff-link">
              🔒 {locale === 'en' ? 'Staff Login' : 'कर्मचारी लॉगिन'}
            </a>
          </div>
        </div>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="app-footer">
      <div class="container footer-content">
        <div class="footer-top">
          <div class="footer-brand-col">
            <strong class="footer-brand-title">{businessName || 'HSR'}</strong>
            <span class="footer-badge-tag">{locale === 'en' ? 'Precision Hydro Test Station' : 'प्रमाणित हाइड्रो टेस्टिंग स्टेशन'}</span>
          </div>

          <div class="footer-links-col">
            <strong class="footer-heading">{locale === 'en' ? 'Customer Services' : 'ग्राहक सेवाएँ'}</strong>
            <ul class="footer-nav-list">
              <li><a href={getAnchor('booking')}>{copy.actions.book}</a></li>
              <li><a href={getAnchor('refused-cng')}>{locale === 'en' ? 'Refused at CNG Pump?' : 'पंप पर मना किया?'}</a></li>
              <li><a href={getAnchor('pricing')}>{locale === 'en' ? 'Transparent Pricing' : 'पारदर्शी शुल्क'}</a></li>
              <li><a href={getAnchor('process')}>{locale === 'en' ? '5-Step Testing Methodology' : '5-चरणीय परीक्षण विधि'}</a></li>
              <li><a href={getAnchor('standards')}>{locale === 'en' ? 'Statutory Standards' : 'वैधानिक सुरक्षा मानक'}</a></li>
            </ul>
          </div>

          <div class="footer-links-col">
            <strong class="footer-heading">{locale === 'en' ? 'Quick Tools' : 'त्वरित साधन'}</strong>
            <ul class="footer-nav-list">
              <li><a href={`/${locale}/check-expiry/`}>{copy.nav.expiry}</a></li>
              <li><a href={`/${locale}/blog/`}>{copy.nav.blog}</a></li>
              <li><a href={getAnchor('location')}>{locale === 'en' ? 'Station Location & Map' : 'स्टेशन का पता व नक्शा'}</a></li>
              <li><a href={getAnchor('faqs')}>{locale === 'en' ? 'Frequently Asked Questions' : 'अक्सर पूछे जाने वाले प्रश्न'}</a></li>
            </ul>
          </div>

          <div class="footer-links-col">
            <strong class="footer-heading">{locale === 'en' ? 'Station Details' : 'स्टेशन विवरण'}</strong>
            <p class="footer-contact-item">
              <strong>{locale === 'en' ? 'Facility:' : 'स्थान:'}</strong> {effectiveSettings.city !== 'SETUP_REQUIRED' ? effectiveSettings.city : 'Rewari'}, Haryana
            </p>
            <p class="footer-contact-item">
              <strong>{locale === 'en' ? 'Hours:' : 'कार्य समय:'}</strong> Mon–Sat 09:00–18:00
            </p>
            {effectiveSettings.contact_phone !== 'SETUP_REQUIRED' && (
              <p class="footer-contact-item">
                <strong>{locale === 'en' ? 'Phone:' : 'फ़ोन:'}</strong> <a href={`tel:${effectiveSettings.contact_phone}`}>{effectiveSettings.contact_phone}</a>
              </p>
            )}
            {effectiveSettings.whatsapp_number !== 'SETUP_REQUIRED' && (
              <p class="footer-contact-item">
                <strong>WhatsApp:</strong> <a href={`https://wa.me/${effectiveSettings.whatsapp_number.replace(/\D/g, '')}`} target="_blank" rel="noreferrer">{effectiveSettings.whatsapp_number}</a>
              </p>
            )}
            {effectiveSettings.show_social_media !== 0 && (
              <div class="footer-social-row" style="margin-top: 1rem; display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
                {effectiveSettings.social_facebook && (
                  <a href={effectiveSettings.social_facebook} target="_blank" rel="noopener noreferrer" class="social-icon-btn" aria-label="Facebook" style="display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 50%; background: #1877f2; color: #fff; text-decoration: none;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                  </a>
                )}
                {effectiveSettings.social_instagram && (
                  <a href={effectiveSettings.social_instagram} target="_blank" rel="noopener noreferrer" class="social-icon-btn" aria-label="Instagram" style="display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 50%; background: linear-gradient(45deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888); color: #fff; text-decoration: none;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                  </a>
                )}
                {effectiveSettings.social_youtube && (
                  <a href={effectiveSettings.social_youtube} target="_blank" rel="noopener noreferrer" class="social-icon-btn" aria-label="YouTube" style="display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 50%; background: #ff0000; color: #fff; text-decoration: none;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                  </a>
                )}
                {effectiveSettings.social_twitter && (
                  <a href={effectiveSettings.social_twitter} target="_blank" rel="noopener noreferrer" class="social-icon-btn" aria-label="Twitter / X" style="display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 50%; background: #000000; color: #fff; text-decoration: none;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                  </a>
                )}
              </div>
            )}
          </div>
        </div>

        <div class="footer-bottom">
          <p class="footer-disclaimer">
            {locale === 'en'
              ? 'Owner-managed business details and accreditations may be marked SETUP_REQUIRED until officially verified by facility management.'
              : 'मालिक द्वारा प्रबंधित जानकारी और प्रमाणपत्र विवरण आधिकारिक सत्यापन तक SETUP_REQUIRED के रूप में चिह्नित हो सकते हैं।'}
          </p>
          <div class="footer-staff-login">
            <a href="/admin/login/" class="staff-login-link">
              {locale === 'en' ? 'Staff / Admin Login' : 'कर्मचारी / एडमिन लॉगिन'}
            </a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Interactive Feedback Component (React Island) -->
    <FeedbackModal client:idle locale={locale} />

    <!-- Accessible Mobile Navigation Toggle Script -->
    <script is:inline>
      (function() {
        const toggle = document.getElementById('mobile-nav-toggle');
        const drawer = document.getElementById('mobile-nav-drawer');
        const backdrop = document.getElementById('mobile-nav-backdrop');
        const closeBtn = document.getElementById('mobile-nav-close');

        if (!toggle || !drawer) return;

        function openDrawer() {
          drawer.removeAttribute('hidden');
          toggle.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
        }

        function closeDrawer() {
          drawer.setAttribute('hidden', '');
          toggle.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        }

        toggle.addEventListener('click', function(e) {
          e.preventDefault();
          const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
          if (isExpanded) {
            closeDrawer();
          } else {
            openDrawer();
          }
        });

        if (backdrop) backdrop.addEventListener('click', closeDrawer);
        if (closeBtn) closeBtn.addEventListener('click', closeDrawer);

        drawer.querySelectorAll('a').forEach(function(link) {
          link.addEventListener('click', closeDrawer);
        });

        window.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && !drawer.hasAttribute('hidden')) {
            closeDrawer();
          }
        });
      })();
    </script>
    <FloatingWhatsApp
      whatsappNumber={effectiveSettings.whatsapp_number}
      contactPhone={effectiveSettings.contact_phone}
      businessName={businessName}
      showFloating={effectiveSettings.show_floating_whatsapp ?? 1}
    />
  </body>
</html>

<style>
  /* Demo Preview Banner */
  .demo-banner {
    background-color: var(--color-navy-950, #050b18);
    color: #f8fafc;
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
    border-bottom: 2px solid var(--color-action, #ea580c);
  }
  .demo-banner-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .demo-banner-content {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .demo-tag {
    background-color: var(--color-action, #ea580c);
    color: #ffffff;
    font-weight: 800;
    font-size: 0.72rem;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm, 4px);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .demo-text {
    color: #e2e8f0;
    font-size: 0.82rem;
    margin: 0;
  }
  .demo-feedback-btn {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.35);
