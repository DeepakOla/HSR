---
import { getStaffContext } from '../lib/auth';
import { getRuntimeEnv } from '../lib/runtime-env';

interface Props {
  title?: string;
  activeTab?: 'reception' | 'testing' | 'certificates' | 'payments' | 'search';
}

const { title = 'Staff Operations | HSR Technical Services', activeTab = 'reception' } = Astro.props;
const env = getRuntimeEnv(Astro.locals);
const staff = await getStaffContext(Astro.request, env);
const staffRole = staff?.role || 'RECEPTIONIST';
const staffEmail = staff?.email || 'staff@hsr.test';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />
    <style>
      :root {
        --color-navy: #0a1128;
        --color-orange: #ea580c;
        --color-cyan: #0284c7;
        --color-bg: #f8fafc;
        --color-card: #ffffff;
        --color-border: #e2e8f0;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: 'Inter', system-ui, sans-serif;
        background: var(--color-bg);
        color: #0f172a;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      .staff-header {
        background: var(--color-navy);
        color: #ffffff;
        padding: 0 1.5rem;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: sticky;
        top: 0;
        z-index: 50;
      }
      .brand-group {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }
      .brand-badge {
        background: var(--color-orange);
        color: #fff;
        font-weight: 800;
        font-size: 0.8rem;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        letter-spacing: 0.05em;
      }
      .brand-name {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-weight: 800;
        font-size: 1.1rem;
        letter-spacing: -0.01em;
      }
      .nav-links {
        display: flex;
        gap: 0.25rem;
      }
      .nav-btn {
        color: #94a3b8;
        padding: 0.45rem 0.85rem;
        border-radius: 6px;
        font-weight: 600;
        font-size: 0.85rem;
        text-decoration: none;
        transition: all 0.12s ease;
      }
      .nav-btn:hover {
        color: #ffffff;
        background: rgba(255, 255, 255, 0.08);
      }
      .nav-btn.active {
        background: #1e293b;
        color: #ffffff;
        font-weight: 700;
      }
      .staff-user-box {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 0.8rem;
      }
      .role-pill {
        background: rgba(2, 132, 199, 0.2);
        color: #38bdf8;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        font-weight: 700;
        text-transform: uppercase;
      }
      .content-wrapper {
        flex: 1;
        padding: 1.5rem;
        max-width: 1400px;
        width: 100%;
        margin: 0 auto;
      }
    </style>
  </head>
  <body>
    <header class="staff-header">
      <div class="brand-group">
        <span class="brand-badge">HSR</span>
        <span class="brand-name">Shop-Floor & Reception Operations</span>
      </div>

      <nav class="nav-links">
        <a href="/staff/reception" class={`nav-btn ${activeTab === 'reception' ? 'active' : ''}`}>
          📋 Reception Desk
        </a>
        <a href="/staff/testing" class={`nav-btn ${activeTab === 'testing' ? 'active' : ''}`}>
          🔧 Testing Worksheet
        </a>
        <a href="/staff/certificates" class={`nav-btn ${activeTab === 'certificates' ? 'active' : ''}`}>
          📄 PESO Queue
        </a>
        <a href="/staff/payments" class={`nav-btn ${activeTab === 'payments' ? 'active' : ''}`}>
          💳 Counter Payments
        </a>
        <a href="/staff/search" class={`nav-btn ${activeTab === 'search' ? 'active' : ''}`}>
          🔍 Global Search
        </a>
      </nav>

      <div class="staff-user-box">
        <span class="role-pill">{staffRole}</span>
        <span style="color: #cbd5e1;">{staffEmail}</span>
        <a href="/api/auth/logout" style="color: #94a3b8; text-decoration: none; font-size: 0.75rem;" title="Sign out">✕</a>
      </div>
    </header>

    <main class="content-wrapper">
      <slot />
    </main>
  </body>
</html>
