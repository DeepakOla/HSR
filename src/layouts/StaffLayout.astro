---
import AdminLayout from './AdminLayout.astro';

interface Props {
  title?: string;
  activeTab?: 'reception' | 'testing' | 'certificates' | 'payments' | 'search';
}

const { title = 'Staff Operations | HSR Technical Services', activeTab = 'reception' } = Astro.props;
const activeNav = activeTab === 'reception' ? 'reception' :
  activeTab === 'testing' ? 'testing' :
  activeTab === 'certificates' ? 'records' :
  activeTab === 'payments' ? 'finance' : 'records';
---

<AdminLayout title={title} activeNav={activeNav}>
  <slot />
</AdminLayout>
