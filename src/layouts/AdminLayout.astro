---
interface Props {
  title: string;
  owner?: boolean;
}
const { title, owner = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title} | HSR Green Energy</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="staff-header">
      <a class="staff-brand" href="/admin/reception"><span class="staff-mark">HSR</span><span><strong>HSR Green Energy</strong><small>Operations desk</small></span></a>
      <nav>
        <a href="/admin/reception">Reception</a>
        {owner && <a href="/admin/owner">Owner settings</a>}
        <a href="/en/">Public website</a>
      </nav>
    </header>
    <main class="staff-content"><slot /></main>
  </body>
</html>
<style>
  :global(*) { box-sizing:border-box }
  :global(body) { margin:0; background:#f4f6f5; color:#18231e; font-family:"DM Sans",system-ui,sans-serif }
  .staff-header { min-height:72px; padding:0 clamp(18px,4vw,54px); background:#fff; border-bottom:1px solid #e1e7e3; display:flex; align-items:center; justify-content:space-between; gap:20px }
  .staff-brand { display:flex; gap:12px; align-items:center; color:inherit; text-decoration:none }
  .staff-mark { width:42px;height:42px;border-radius:12px;background:#0e4937;color:#fff;display:grid;place-items:center;font-family:Manrope,sans-serif;font-weight:800;letter-spacing:-1px }
  .staff-brand strong,.staff-brand small { display:block }
  .staff-brand strong { font-family:Manrope,sans-serif;font-size:15px }
  .staff-brand small { color:#64736a;font-size:11px;margin-top:2px }
  nav { display:flex;gap:20px;align-items:center;flex-wrap:wrap }
  nav a { color:#45554b;text-decoration:none;font-size:13px;font-weight:600 }
  nav a:hover { color:#0e4937 }
  .staff-content { max-width:1360px;margin:0 auto;padding:28px clamp(16px,3vw,36px) 56px }
  @media(max-width:640px) { .staff-header { align-items:flex-start;padding:14px 16px;flex-direction:column;gap:12px } nav { width:100%;gap:16px } .staff-content { padding:18px 14px 40px } }
</style>
