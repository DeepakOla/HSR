{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hsr-green-energy",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hsr_green_energy_prod",
      "database_id": "SETUP_REQUIRED",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_BASE_URL": "https://SETUP_REQUIRED.example",
    "ACCESS_AUDIENCE": "SETUP_REQUIRED",
    "ACCESS_TEAM_DOMAIN": "SETUP_REQUIRED.cloudflareaccess.com",
    "R2_MAX_EVIDENCE_BYTES": "1048576"
  }
}
